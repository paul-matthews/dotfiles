# Starship Configuration

# Get editor completions based on the config schema
"$schema" = 'https://starship.rs/config-schema.json'

# Global timeout settings to prevent lag in large repos/vaults
command_timeout = 2000
scan_timeout = 100

# Use custom symbols for modules
[git_branch]
symbol = " "

[git_status]
ahead = "⇡"
behind = "⇣"
diverged = "⇕"
renamed = "»"
deleted = "✘"

[python]
symbol = "🐍 "
pyenv_prefix = "venv "

[nodejs]
symbol = " "

[package]
disabled = true

[aws]
symbol = " "

[docker_context]
symbol = " "

[memory_usage]
symbol = " "

[custom.gandalf]
command = "gandalf-prompt"
when = "gandalf-prompt"
format = "via [$symbol$output]($style) "
symbol = "🧙‍♂️ "
style = "bold cyan"

[env_var.TERMINAL_ROLE]
variable = "TERMINAL_ROLE"
format = "[$symbol$env_value]($style) "
symbol = "🏷️ "
style = "bold yellow"


