#==============================================================================
# Zsh Configuration
#==============================================================================

# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles

# your project folder that we can `c [tab]` to
export PROJECTS=~/Code

#==============================================================================
# Antigen (Plugin Manager)
#==============================================================================

# Disable auto-compilation to prevent ZWC write errors
export ANTIGEN_AUTO_CONFIG=false

# Load Antigen
source $ZSH/zsh/antigen.zsh

# Load the oh-my-zsh library
antigen use oh-my-zsh > /dev/null

#==============================================================================
# Plugins
#==============================================================================

# Syntax highlighting
antigen bundle zsh-users/zsh-syntax-highlighting > /dev/null

# Auto-suggestions
antigen bundle zsh-users/zsh-autosuggestions > /dev/null

# History search
antigen bundle zsh-users/zsh-history-substring-search > /dev/null

# Fuzzy finder
antigen bundle fzf > /dev/null

#==============================================================================
# Dotfiles Loading logic
#==============================================================================

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

#==============================================================================
# Configuration
#==============================================================================

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS

# Editor
export EDITOR='vim'

#==============================================================================
# Aliases
#==============================================================================

alias reload!='. ~/.zshrc'
alias cls='clear'
alias mv='nocorrect mv'
alias cp='nocorrect cp'
alias mkdir='nocorrect mkdir'
alias pu=pushd
alias po=popd
alias d='dirs -v'
alias h=history
alias grep=egrep
alias gvimdiff="mvimdiff"
alias vim="vim -p"
alias -g M='| more'
alias -g H='| head'
alias -g T='| tail'
alias -g L='| less'
alias -g G="| grep"

# Modern replacements for ls
if (( $+commands[eza] ))
then
  alias ls="eza --icons --group-directories-first"
  alias l="eza -lAh --icons --group-directories-first"
  alias ll="eza -l --icons --group-directories-first"
  alias la='eza -a --icons --group-directories-first'
fi

# VIM Keybindings
bindkey -v

#==============================================================================
# Apply Antigen Configuration
#==============================================================================

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

antigen apply > /dev/null

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

#==============================================================================
# Prompt Configuration (Starship)
#==============================================================================

if (( $+commands[starship] ))
then
  eval "$(starship init zsh)"
fi

#==============================================================================
# Zoxide (Modern z command)
#==============================================================================

if (( $+commands[zoxide] ))
then
  eval "$(zoxide init zsh)"
fi

#==============================================================================
# Local Configuration
#==============================================================================

if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi
