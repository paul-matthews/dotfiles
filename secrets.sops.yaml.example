# Example secrets file: valid zsh, decrypted by `secrets pull` to ~/.localrc.secrets
# and encrypted by `secrets push` into secrets.sops.yaml.
#
# One file for every machine, so scope lines with dotfiles_has_tag
# (home, work, darwin, linux, pi) and pick tool paths by existence, never by tag.

export SOME_TOKEN="…"

if dotfiles_has_tag work; then
  for _p in /path/on/linux/tool /path/on/mac/tool; do
    [[ -x "$_p" ]] && alias tool="$_p" && break
  done
  unset _p
  export INTERNAL_HOST="host.example.internal"
  if dotfiles_has_tag darwin; then
    connect() { ssh -A "$INTERNAL_HOST"; }
  fi
fi
