#!/usr/bin/env bash
#
# script/test — verify the dotfiles load correctly in a fresh interactive zsh.
#
# Starts a new `zsh -i` under a pseudo-terminal (so it sees exactly what a
# terminal tab sees), collects facts from it, and checks them against what
# CLAUDE.md promises. Exit 0 means every check passed.
#
# Used by:
#   - each phase of the normalisation plan, as its "Test:" line
#   - `gsp` after every pull (a failure rolls the pull back)
#   - the work-machine handoff runbooks, whose reports quote its output
#
# Add a check here whenever a change adds a promise worth keeping.

set -u
cd "$(dirname "$0")/.." || exit 2
DOTFILES_ROOT="$(pwd -P)"

pass=0
fail=0
skip=0
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; pass=$((pass + 1)); }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; fail=$((fail + 1)); }
skp()  { printf '  \033[33m-\033[0m %s (skipped: %s)\n' "$1" "$2"; skip=$((skip + 1)); }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

#------------------------------------------------------------------------------
# Probe: start a fresh interactive zsh under a pty, stderr captured separately
#------------------------------------------------------------------------------
probe='
print
print -r -- "EDITOR=$EDITOR"
print -r -- "PROJECTS=$PROJECTS"
print -r -- "PATH=$PATH"
print -r -- "DOTFILES_PROFILE=$DOTFILES_PROFILE"
print -r -- "DOTFILES_TAGS=$DOTFILES_TAGS"
for f in tabcolor gwa cpush role reload! gsp gandalf_prompt_precmd _git_configure_work_hosts claude agy _tabcolor_preset_for wb; do
  print -r -- "WHENCE:$f=$(whence -w $f 2>/dev/null)"
done
print -r -- "PRESET_COSMIC=$(TABCOLOR_PRESET= _tabcolor_preset_for $HOME/src/pico/cosmic-clock 2>/dev/null)"
print -r -- "PRESET_DOTFILES=$(TABCOLOR_PRESET= _tabcolor_preset_for $HOME/src/system/dotfiles 2>/dev/null)"
print -r -- "PRESET_LACASA=$(TABCOLOR_PRESET= _tabcolor_preset_for $HOME/src/pi/la-casa 2>/dev/null)"
print -r -- "PRESET_PI=$(TABCOLOR_PRESET= _tabcolor_preset_for $HOME/src/Pi/network-audit 2>/dev/null)"
print -r -- "PRESET_TOOLROLL=$(TABCOLOR_PRESET= _tabcolor_preset_for $HOME/src/tool-roll 2>/dev/null)"
_TABCOLOR_SSH_TABLE="
probea|PRA|🅰️|1 2 3|000000|host-a.local host-a
probeb|PRB|🅱️|4 5 6|111111|host-b.local
"
print -r -- "SSH_A=$(_ssh_host_row -A user@Host-A.local uptime 2>/dev/null | cut -d"|" -f1)"
print -r -- "SSH_B=$(_ssh_host_row host-b.local 2>/dev/null | cut -d"|" -f1)"
print -r -- "SSH_OTHER=$(_ssh_host_row example.com 2>/dev/null | cut -d"|" -f1)"
print -r -- "PRESET_NONE=$(TABCOLOR_PRESET= _tabcolor_preset_for /usr/local 2>/dev/null)"
print -r -- "PRESET_OVERRIDE=$(TABCOLOR_PRESET=herd _tabcolor_preset_for /usr/local 2>/dev/null)"
if (( $+functions[_tabcolor_resolve] )); then  # not in DOTFILES_SAFE=1
TABCOLOR_PRESET= _tabcolor_resolve $HOME/src/.worktrees/tool-roll--feat-x/sub; _tabcolor_group_name "$REPLY" "$_TC_WT"
print -r -- "WT_GROUP=$REPLY"
_tabcolor_group_name dotfiles; print -r -- "GROUP_DOTFILES=$REPLY"
print -r -- "TEMPLATE_DOTFILES=${_TC_TEMPLATE[dotfiles]}"
print -r -- "TEMPLATE_COSMIC=${_TC_TEMPLATE[cosmic]}"
print -r -- "GROUP_RGB_DOTFILES=${_TC_GROUP_RGB[dotfiles]}"
_s=(0 0 0); for _e in "${(@s:|:)_TC_PALETTE[dotfiles]}"; do _c=(${=_e}); for _i in 1 2 3; do (( _s[_i] += _c[_i] )); done; done
print -r -- "PALETTE_AVG_DOTFILES=$(( (_s[1] + 4) / 8 )) $(( (_s[2] + 4) / 8 )) $(( (_s[3] + 4) / 8 ))"
_TC_ORDER=(probex "${_TC_ORDER[@]}"); _TC_TAG[probex]=work; _TC_GLOBS[probex]="*/probe-x*"; _TC_SHORT[probex]=PRX
print -r -- "TAGGED_OFF=$(TABCOLOR_PRESET= DOTFILES_TAGS="home darwin" _tabcolor_preset_for /x/probe-x)"
print -r -- "TAGGED_ON=$(TABCOLOR_PRESET= DOTFILES_TAGS="work darwin" _tabcolor_preset_for /x/probe-x)"
zmodload zsh/datetime; cd $HOME; _tabcolor_hook >/dev/null; _t0=$EPOCHREALTIME
repeat 200 _tabcolor_hook >/dev/null
print -r -- "HOOK_200_MS=$(( int((EPOCHREALTIME - _t0) * 1000) ))"
_d=$(mktemp -d); mkdir -p $_d/dotfiles/android $_d/a/tool-roll
PROJECTS=$_d _tabcolor_root android; print -r -- "ROOT_ANDROID=${REPLY#$_d}"
PROJECTS=$_d _tabcolor_root toolroll; print -r -- "ROOT_TOOLROLL=${REPLY#$_d}"
rm -rf $_d
fi
alias _probe_tool="echo probe-tool-ran"; _AI_TAB_CMDS+=(_probe_tool:PROBE); _ai_tabs_finalize
print -r -- "WRAPPED_ALIAS=$(whence -w _probe_tool | awk "{print \$NF}")"
print -r -- "WRAPPED_RUN=$(_probe_tool arg1 2>/dev/null | LC_ALL=C tr -d "\000-\037" | grep -o "probe-tool-ran arg1")"
print -r -- "AI_CMDS=${(j: :)_AI_TAB_CMDS}"
_AI_TAB_CMDS+=(_probe_absent:ABSENT); _ai_tabs_finalize
print -r -- "WRAPPED_ABSENT=$(whence -w _probe_absent 2>/dev/null | awk "{print \$NF}")"
for e in $_AI_TAB_CMDS; do n=${e%%:*}; print -r -- "AI_TOOL:$n=$(whence -w $n 2>/dev/null | awk "{print \$NF}"):${+commands[$n]}"; done
print -r -- "HAS_TAG_YES=$(dotfiles_has_tag $DOTFILES_PROFILE && echo y)"
print -r -- "HAS_TAG_NO=$(dotfiles_has_tag no-such-tag || echo n)"
print -r -- "LOAD_ORDER=$(_dotfiles_sorted x/ai.work.zsh x/ai.zsh x/ai.work.linux.zsh | tr "\n" " ")"
print -r -- "PROBE_DONE"
'

# run_probe <name> [VAR=value ...]: writes $tmp/<name>.out (cleaned) and $tmp/<name>.err
run_probe() {
  local name="$1"; shift
  local inner="zsh -ic \"\$0\" 2>\"\$1\""
  if script --version >/dev/null 2>&1; then
    # util-linux script (Linux)
    env "$@" script -qec "zsh -c '$inner' \"\$probe\" \"$tmp/$name.err\"" /dev/null \
      >"$tmp/$name.raw" 2>/dev/null </dev/null
  else
    # BSD script (macOS)
    env "$@" script -q /dev/null zsh -c "$inner" "$probe" "$tmp/$name.err" \
      >"$tmp/$name.raw" 2>/dev/null </dev/null
  fi
  # strip CRs, OSC escape sequences (iTerm shell integration) and control chars
  perl -pe 's/\r//g; s/\e\][^\a\e]*(\a|\e\\)//g; s/\e\[[0-9;?]*[A-Za-z]//g; s/[\x00-\x08\x0b-\x1f]//g' \
    <"$tmp/$name.raw" >"$tmp/$name.out"
}

get()    { grep -m1 "^$2=" "$tmp/$1.out" | cut -d= -f2-; }
whence_kind() {  # function | alias | command | ... ; empty when not defined
  local k; k="$(grep -m1 "^WHENCE:$2=" "$tmp/$1.out" | cut -d= -f2- | awk '{print $NF}')"
  [[ "$k" == "none" ]] || printf '%s' "$k"
}

export probe
# An agent's shell may have TERM=dumb, which makes starship complain on stderr
[[ -z "${TERM:-}" || "$TERM" == dumb ]] && export TERM=xterm-256color
run_probe main
run_probe safe DOTFILES_SAFE=1

echo "script/test: fresh interactive zsh in $DOTFILES_ROOT"

#------------------------------------------------------------------------------
# 1. Startup
#------------------------------------------------------------------------------
if grep -q '^PROBE_DONE' "$tmp/main.out"; then
  ok "interactive zsh starts and reaches the prompt"
else
  bad "interactive zsh did not start"
  head -20 "$tmp/main.err" 2>/dev/null | sed 's/^/      /'
  trap - EXIT
  exit 1
fi

if grep -q '[^[:space:]]' "$tmp/main.err" 2>/dev/null; then
  bad "startup wrote to stderr:"
  sed 's/^/      /' "$tmp/main.err" | head -20
else
  ok "startup wrote nothing to stderr"
fi

#------------------------------------------------------------------------------
# 2. Environment promises
#------------------------------------------------------------------------------
v="$(get main EDITOR)"
[[ "$v" == "vim" ]] && ok "EDITOR is vim" || bad "EDITOR is '$v', expected vim"

v="$(get main PROJECTS)"
[[ "$v" == "$HOME/src" ]] && ok "PROJECTS is ~/src" || bad "PROJECTS is '$v', expected $HOME/src"

PATH_VAL="$(get main PATH)"
case ":$PATH_VAL:" in
  *":./bin:"*) bad "PATH contains ./bin" ;;
  *) ok "PATH has no ./bin" ;;
esac
case "$PATH_VAL" in
  *"/Users/holman/"*) bad "PATH contains /Users/holman/" ;;
  *) ok "PATH has no /Users/holman/" ;;
esac

if [[ -d /Applications/Obsidian.app/Contents/MacOS ]]; then
  case ":$PATH_VAL:" in
    *":/Applications/Obsidian.app/Contents/MacOS:"*) ok "Obsidian is installed and on PATH" ;;
    *) bad "Obsidian is installed but not on PATH" ;;
  esac
else
  skp "Obsidian on PATH" "Obsidian not installed here"
fi

#------------------------------------------------------------------------------
# 3. Machine profile and tags
#------------------------------------------------------------------------------
expected_profile="home"
[[ -r "$HOME/.dotfiles-profile" ]] && expected_profile="$(tr -d '[:space:]' < "$HOME/.dotfiles-profile")"
v="$(get main DOTFILES_PROFILE)"
[[ "$v" == "$expected_profile" ]] && ok "DOTFILES_PROFILE is $expected_profile" || bad "DOTFILES_PROFILE is '$v', expected $expected_profile"

os_tag="$(uname -s | tr '[:upper:]' '[:lower:]')"
tags=" $(get main DOTFILES_TAGS) "
if [[ "$tags" == *" $expected_profile "* && "$tags" == *" $os_tag "* ]]; then
  ok "DOTFILES_TAGS contains '$expected_profile' and '$os_tag' (${tags# })"
else
  bad "DOTFILES_TAGS is '${tags# }', expected to contain '$expected_profile' and '$os_tag'"
fi

if [[ "$expected_profile" == "home" ]]; then
  v="$(whence_kind main gandalf_prompt_precmd)"
  [[ -z "$v" ]] && ok "work-only gandalf hook is not loaded on a home profile" || bad "gandalf hook loaded on a home profile"
  v="$(whence_kind main _git_configure_work_hosts)"
  [[ -z "$v" ]] && ok "work-only git config helper is not loaded on a home profile" || bad "work git config helper loaded on a home profile"
else
  skp "gandalf hook absent" "work profile"
  v="$(whence_kind main _git_configure_work_hosts)"
  [[ "$v" == "function" ]] && ok "_git_configure_work_hosts is a function on a work profile" || bad "_git_configure_work_hosts is '${v:-missing}', expected function"
fi

#------------------------------------------------------------------------------
# 4. Topic functions and aliases that must exist
#------------------------------------------------------------------------------
for spec in tabcolor:function gwa:function cpush:function role:function reload!:alias gsp:alias; do
  name="${spec%%:*}"; kind="${spec##*:}"
  actual="$(whence_kind main "$name")"
  [[ "$actual" == "$kind" ]] && ok "$name is a $kind" || bad "$name is '${actual:-missing}', expected $kind"
done

#------------------------------------------------------------------------------
# 5. Safe mode: DOTFILES_SAFE=1 gives a usable shell with no topic files
#------------------------------------------------------------------------------
if grep -q '^PROBE_DONE' "$tmp/safe.out"; then
  v="$(whence_kind safe tabcolor)"
  [[ -z "$v" ]] && ok "DOTFILES_SAFE=1 starts a shell with no topic files loaded" || bad "DOTFILES_SAFE=1 still loaded topic files"
else
  bad "DOTFILES_SAFE=1 shell did not start"
fi

v="$(get main AI_CMDS)"; [[ "$v" == *claude:CLAUDE* && "$v" == *agy:ANTIGRAVITY* ]] && ok "AI wrapper registry holds the shared tools ($v)" || bad "AI wrapper registry is '$v'"
v="$(get main LOAD_ORDER)"; [[ "$v" == "x/ai.zsh x/ai.work.zsh x/ai.work.linux.zsh " ]] && ok "an untagged topic file loads before its tagged variants" || bad "load order is '$v'"
v="$(get main WRAPPED_ALIAS)"; [[ "$v" == function ]] && ok "an aliased AI tool becomes a wrapped function after ~/.localrc" || bad "wrapped alias is '$v', expected function"
v="$(get main WRAPPED_RUN)"; [[ "$v" == "probe-tool-ran arg1" ]] && ok "the wrapped alias runs its expansion with arguments" || bad "wrapped alias run gave '$v'"
v="$(get main WRAPPED_ABSENT)"; [[ "$v" == none ]] && ok "a registered AI tool that is not installed gets no wrapper" || bad "absent tool wrapper is '$v', expected none"
# Every registered tool: a function when installed (or when an alias was
# converted); otherwise undefined. Never a bare command or a lie.
bad_tools=""
while IFS= read -r line; do
  n="${line#AI_TOOL:}"; n="${n%%=*}"; rest="${line#*=}"; kind="${rest%%:*}"; present="${rest##*:}"
  case "$n" in _probe_tool|_probe_absent) continue ;; esac
  if [[ "$present" == 1 && "$kind" != function ]] || [[ "$kind" != function && "$kind" != none ]]; then
    bad_tools="$bad_tools $n($kind,installed=$present)"
  fi
done < <(grep '^AI_TOOL:' "$tmp/main.out")
[[ -z "$bad_tools" ]] && ok "every registered AI tool is wrapped when installed and undefined when not" || bad "AI tools out of step:$bad_tools"
v="$(get main HAS_TAG_YES)"; w="$(get main HAS_TAG_NO)"
[[ "$v" == y && "$w" == n ]] && ok "dotfiles_has_tag matches the profile and rejects an unknown tag" || bad "dotfiles_has_tag gave yes='$v' no='$w'"
v="$(get safe HAS_TAG_YES)"; [[ "$v" == y ]] && ok "dotfiles_has_tag works under DOTFILES_SAFE=1" || bad "dotfiles_has_tag under DOTFILES_SAFE=1 gave '$v'"

#------------------------------------------------------------------------------
# 5b. Tab colour engine: path map first, .envrc override, nothing elsewhere
#------------------------------------------------------------------------------
if [[ "$expected_profile" == "home" ]]; then
  v="$(get main PRESET_COSMIC)"; [[ "$v" == cosmic ]] && ok "path map: cosmic-clock -> cosmic" || bad "path map gave '$v' for cosmic-clock, expected cosmic"
  v="$(get main PRESET_LACASA)"; w="$(get main PRESET_PI)"
  [[ "$v" == lacasa && "$w" == pi ]] && ok "path map: la-casa wins over the general ~/src/pi row" || bad "path map gave '$v' for la-casa and '$w' for ~/src/Pi, expected lacasa and pi"
fi
v="$(get main PRESET_TOOLROLL)"; [[ "$v" == toolroll ]] && ok "path map: tool-roll -> toolroll on every profile" || bad "path map gave '$v' for tool-roll, expected toolroll"
v="$(get main SSH_A)"; w="$(get main SSH_B)"; x="$(get main SSH_OTHER)"
if [[ "$v" == probea && "$w" == probeb && -z "$x" ]]; then
  ok "ssh host colours: table hosts matched (user@, options, any case), other hosts default"
else
  bad "ssh host rows gave a='$v' b='$w' other='$x'"
fi
v="$(get main PRESET_DOTFILES)"; [[ "$v" == dotfiles ]] && ok "path map: dotfiles -> dotfiles" || bad "path map gave '$v' for dotfiles, expected dotfiles"
v="$(get main PRESET_NONE)"; [[ -z "$v" ]] && ok "path map: unknown directory has no preset" || bad "path map gave '$v' for /usr/local"
v="$(get main PRESET_OVERRIDE)"; [[ "$v" == herd ]] && ok "TABCOLOR_PRESET from .envrc overrides the map" || bad "override gave '$v', expected herd"
v="$(get main WT_GROUP)"; [[ "$v" == "🧰 Tool Roll · feat-x" ]] && ok "a ~/src/.worktrees checkout matches its project, group named with the worktree" || bad "worktree group is '$v', expected '🧰 Tool Roll · feat-x'"
v="$(get main GROUP_DOTFILES)"; [[ "$v" == "📂 Dotfiles" ]] && ok "tab group name is '<emoji> <name>'" || bad "group name is '$v'"
v="$(get main TEMPLATE_DOTFILES)"; [[ "$v" == "ai control" ]] && ok "wb template defaults to ai + control" || bad "dotfiles template is '$v', expected 'ai control'"
v="$(get main TEMPLATE_COSMIC)"; [[ "$v" == "ai control run" ]] && ok "wb template: cosmic adds a run tab" || bad "cosmic template is '$v'"
v="$(get main GROUP_RGB_DOTFILES)"; w="$(get main PALETTE_AVG_DOTFILES)"
[[ -n "$v" && "$v" == "$w" ]] && ok "group colour is the palette average ($v)" || bad "group colour '$v' is not the palette average '$w'"
v="$(get main TAGGED_OFF)"; w="$(get main TAGGED_ON)"
[[ -z "$v" && "$w" == probex ]] && ok "a work-tagged project matches only on work machines" || bad "tagged project gave off='$v' on='$w'"
v="$(get main ROOT_ANDROID)"; w="$(get main ROOT_TOOLROLL)"
[[ -z "$v" && "$w" == /a/tool-roll ]] && ok "wb project folders: found by glob, never a folder inside another project" || bad "project folder discovery gave android='$v' toolroll='$w'"
v="$(get main HOOK_200_MS)"
[[ -n "$v" && "$v" -lt 150 ]] && ok "precmd hook on an unchanged directory does not fork (200 runs in ${v}ms)" || bad "precmd hook is slow: 200 runs took ${v:-?}ms (forking?)"

# Project data: the committed fallback matches the YAML, the generator rejects
# bad input, and wb's planner passes its own tests (all need uv's cache).
if command -v uv >/dev/null 2>&1; then
  if "$DOTFILES_ROOT/bin/projects-gen" --stdout --public-only 2>"$tmp/gen.err" | cmp -s - "$DOTFILES_ROOT/system/projects.gen"; then
    ok "system/projects.gen matches system/projects.yaml"
  elif [[ -s "$tmp/gen.err" ]] && grep -qi 'network\|offline\|resolve\|download' "$tmp/gen.err"; then
    skp "system/projects.gen in sync" "uv could not fetch PyYAML"
  else
    bad "system/projects.gen is stale: run bin/projects-gen --committed and commit it"
  fi
  printf 'a:\n  short: A\n  emoji: x\n  name: A\n  globs: ["*/a"]\n  palette: ["1 2 3"]\n' > "$tmp/bad.yaml"
  printf 'a:\n  short: A\n  emoji: x\n  name: A\n  globs: ["*/a"]\n  base: "1 2 3"\nb:\n  short: A\n  emoji: y\n  name: B\n  globs: ["*/b"]\n  base: "1 2 3"\n' > "$tmp/dup.yaml"
  if ! "$DOTFILES_ROOT/bin/projects-gen" --check --public-only --public "$tmp/bad.yaml" 2>/dev/null \
     && ! "$DOTFILES_ROOT/bin/projects-gen" --check --public-only --public "$tmp/dup.yaml" 2>/dev/null \
     && "$DOTFILES_ROOT/bin/projects-gen" --check --public "$DOTFILES_ROOT/system/projects.yaml" --private "$DOTFILES_ROOT/projects.private.yaml.example" 2>/dev/null; then
    ok "projects-gen rejects a short palette and a duplicate short name, accepts the private example"
  else
    bad "projects-gen validation is wrong (bad input accepted or the example refused)"
  fi
  if out="$("$DOTFILES_ROOT/iterm/wb.py" _selftest 2>&1)" && [[ "$out" == *"selftest: ok"* ]]; then
    ok "wb planner self-test"
  elif [[ "$out" == *selftest:* ]]; then
    bad "wb planner self-test: $out"
  else
    skp "wb planner self-test" "uv could not run it: $(head -1 <<<"$out")"
  fi
else
  skp "project data and wb self-tests" "uv not installed"
fi

if [[ "$(uname -s)" == Darwin ]]; then
  dp="$HOME/Library/Application Support/iTerm2/DynamicProfiles/dotfiles-default.json"
  [[ -L "$dp" ]] && ok "iTerm 'Dotfiles Default' profile is linked" || bad "iTerm dynamic profile not linked (run script/bootstrap)"
  want_guid="$(sed -nE 's/.*"Guid": *"([^"]+)".*/\1/p' "$DOTFILES_ROOT/iterm/DynamicProfiles/dotfiles-default.json" | head -1)"
  have_guid="$(defaults read com.googlecode.iterm2 "Default Bookmark Guid" 2>/dev/null || true)"
  [[ "$have_guid" == "$want_guid" ]] && ok "iTerm default profile is 'Dotfiles Default'" || bad "iTerm default profile is not 'Dotfiles Default' (run script/bootstrap, restart iTerm)"
  [[ -e "$HOME/Library/Application Support/iTerm2/DynamicProfiles/projects.json" ]] && bad "retired projects.json still in DynamicProfiles" || ok "retired dynamic profiles are gone"
  v="$(whence_kind main wb)"; [[ "$v" == function ]] && ok "wb is a function on macOS" || bad "wb is '${v:-missing}' on macOS, expected function"
else
  v="$(whence_kind main wb)"; [[ -z "$v" ]] && ok "wb is not defined off macOS" || bad "wb is '$v' off macOS"
  if [[ "$expected_profile" == "home" ]]; then
    "$DOTFILES_ROOT/bin/claude-hooks" check && ok "Claude hooks match claude/hooks.json" || bad "Claude hooks differ from claude/hooks.json (run: bin/claude-hooks install)"
    [[ -e "$HOME/.claude/session-tab-color.sh" ]] && bad "old ~/.claude/session-tab-color.sh still exists" || ok "old Claude tab-colour hook script is gone"
  fi
fi

#------------------------------------------------------------------------------
# 6. Repository promises
#------------------------------------------------------------------------------
if git -C "$DOTFILES_ROOT" grep -q -e '~/Code' -e '$HOME/Code' -- . ':!vendor' ':!script/test' 2>/dev/null; then
  bad "repo still references ~/Code"
else
  ok "no ~/Code references in the repo"
fi

if git -C "$DOTFILES_ROOT" check-ignore -q bin/probe-file-that-does-not-exist; then
  bad "bin/ is gitignored"
else
  ok "bin/ is not gitignored"
fi

syntax_bad=0
while IFS= read -r f; do
  zsh -n "$f" 2>"$tmp/syn" || { syntax_bad=1; printf '      %s: %s\n' "$f" "$(head -1 "$tmp/syn")"; }
done < <(git -C "$DOTFILES_ROOT" ls-files -- '*.zsh' 'zsh/*.symlink' | grep -v '^vendor/')
[[ $syntax_bad -eq 0 ]] && ok "every tracked zsh file parses" || bad "zsh syntax errors above"

# Files that must not exist once a phase has removed them (added per phase)
absent=(zsh/gandalf.zsh system/tabcolor-palettes.sh iterm/DynamicProfiles/projects.json
        system/tabcolor-presets.sh bin/iterm-layout iterm/iterm_layouts.yaml.example)
for f in "${absent[@]}"; do
  [[ -e "$DOTFILES_ROOT/$f" ]] && bad "$f should have been removed" || ok "$f is gone"
done

# gsp merge resolver: strategies + fixtures (fast; the full scenario harness is
# script/test-gsp and is deliberately not run here, to keep gsp's verify quick)
if out="$("$DOTFILES_ROOT/bin/git-meta-resolve" self-test 2>&1)"; then
  ok "git-meta-resolve self-test ($(tail -1 <<<"$out"))"
else
  bad "git-meta-resolve self-test failed:"; sed 's/^/      /' <<<"$out" | head -20
fi
"$DOTFILES_ROOT/bin/git-meta-resolve" check-config "$DOTFILES_ROOT/git/gsp-merge.toml.example" >/dev/null 2>&1 \
  && ok "gsp-merge.toml.example template is a valid config" || bad "gsp-merge.toml.example does not validate"
syntax_bad=0
for f in bin/git-safe-pull bin/gsp-verify script/test-gsp; do
  bash -n "$DOTFILES_ROOT/$f" 2>"$tmp/syn" || { syntax_bad=1; printf '      %s: %s\n' "$f" "$(head -1 "$tmp/syn")"; }
done
[[ $syntax_bad -eq 0 ]] && ok "gsp bash scripts parse" || bad "gsp bash syntax errors above"

# Work git config helper: overrides user.email on matching work remotes (https,
# sso, ssh, and both single- and multi-segment git@host:... paths) while leaving
# GitHub remotes on the personal email from ~/.gitconfig.local.
(
  gwhome="$tmp/gitwork"
  mkdir -p "$gwhome"
  ln -s "$DOTFILES_ROOT/git/gitconfig.symlink" "$gwhome/.gitconfig"
  printf '[user]\n\tname = Test\n\temail = personal@example.com\n' > "$gwhome/.gitconfig.local"
  HOME="$gwhome" zsh -c 'source "$1/git/config.work.zsh" && _git_configure_work_hosts "corp@work.example" "work.example" "corp.work.example"' _ "$DOTFILES_ROOT"
  for spec in \
    "https://work.example/org/repo.git:corp@work.example" \
    "sso://work.example/org/repo:corp@work.example" \
    "ssh://git@work.example/org/repo.git:corp@work.example" \
    "git@work.example:repo.git:corp@work.example" \
    "git@work.example:org/repo.git:corp@work.example" \
    "https://corp.work.example/org/repo.git:corp@work.example" \
    "git@github.com:user/repo.git:personal@example.com"; do
    url="${spec%:*}"; want="${spec##*:}"
    rm -rf "$gwhome/repo" && git init -q "$gwhome/repo"
    git -C "$gwhome/repo" remote add origin "$url"
    got="$(HOME="$gwhome" GIT_CONFIG_GLOBAL="$gwhome/.gitconfig" git -C "$gwhome/repo" config user.email)"
    [[ "$got" == "$want" ]] || exit 1
  done
) && ok "_git_configure_work_hosts overrides user.email only for matching work remotes" \
  || bad "_git_configure_work_hosts failed remote URL matching check"

# toolroll/install.sh once wrote a dotfiles_has_tag into the crank config that
# compared its own argument instead of the tag; it now rewrites such a file.
# A skip, not a failure, so the pull that brings the fix is not rolled back.
ccfg="$HOME/.config/crank/config"
if [[ ! -f "$ccfg" ]]; then
  skp "crank config dotfiles_has_tag" "no ~/.config/crank/config"
elif grep -q 'dotfiles_has_tag()' "$ccfg" && ! grep -qF '[[ "$1" ==' "$ccfg"; then
  skp "crank config dotfiles_has_tag" "pre-fix config pending a rewrite, run: zsh -ic toolroll/install.sh"
else
  ok "crank config has no pre-fix dotfiles_has_tag"
fi

if [[ "$expected_profile" == "work" && -f "$HOME/.gitconfig.work.user" ]]; then
  work_email="$(git config -f "$HOME/.gitconfig.work.user" user.email 2>/dev/null)"
  dotfiles_email="$(git -C "$DOTFILES_ROOT" config user.email 2>/dev/null)"
  if [[ -n "$work_email" && "$dotfiles_email" != "$work_email" ]]; then
    ok "dotfiles repo keeps personal git email ($dotfiles_email) on a work machine"
  else
    bad "dotfiles repo resolved to work git email '$dotfiles_email'"
  fi
fi

# Link files follow the loader's tag rule (script/links.sh): right variant per
# machine, dotted names that aren't tags untouched, two claimants refused.
(
  . "$DOTFILES_ROOT/script/links.sh"
  r="$tmp/links"; mkdir -p "$r/zsh" "$r/git"
  touch "$r/zsh/zshrc.symlink" "$r/git/gitconfig.local.symlink" \
        "$r/zsh/zshenv.darwin.symlink" "$r/zsh/zshenv.work.linux.symlink" "$r/zsh/zshenv.pi.symlink"
  plan() { link_plan "$r" symlink "H/." "$1" | awk -F'\t' '{sub(".*/", "", $1); printf "%s>%s ", $1, $2}'; }
  [[ "$(plan 'home darwin')" == "gitconfig.local.symlink>H/.gitconfig.local zshenv.darwin.symlink>H/.zshenv zshrc.symlink>H/.zshrc " ]] || exit 1
  [[ "$(plan 'work darwin')" == *"zshenv.darwin.symlink>H/.zshenv"* ]] || exit 1
  [[ "$(plan 'work linux')" == *"zshenv.work.linux.symlink>H/.zshenv"* ]] || exit 1
  [[ "$(plan 'home linux pi')" == *"zshenv.pi.symlink>H/.zshenv"* ]] || exit 1
  [[ "$(plan 'home linux')" != *zshenv* ]] || exit 1
  touch "$r/zsh/zshenv.linux.symlink"
  ! link_plan "$r" symlink "H/." "home linux pi" >/dev/null
) && ok "tagged link files: right variant per machine, plain dotted names kept, clashes refused" \
  || bad "tagged link files: script/links.sh picked the wrong variants or allowed a clash"

# ~/.zshenv gives non-interactive shells (ssh host cmd) the basics on PATH
if [[ -e "$HOME/.zshenv" ]]; then
  ni_path="$(env -i HOME="$HOME" PATH=/usr/bin:/bin /bin/zsh -c 'print -r -- $PATH' 2>/dev/null)"
  missing=()
  [[ -d "$HOME/.local/bin" && ":$ni_path:" != *":$HOME/.local/bin:"* ]] && missing+=("~/.local/bin")
  [[ "$(uname -s)" == Darwin && -d /opt/homebrew/bin && ":$ni_path:" != *":/opt/homebrew/bin:"* ]] && missing+=("/opt/homebrew/bin")
  if [[ ${#missing[@]} -eq 0 ]]; then
    ok "non-interactive zsh (ssh host cmd) has ~/.local/bin$([[ "$(uname -s)" == Darwin ]] && echo ' and Homebrew') on PATH"
  else
    bad "non-interactive zsh is missing ${missing[*]} on PATH (check ~/.zshenv)"
  fi
else
  skp "non-interactive zsh PATH" "no ~/.zshenv on this machine (run script/bootstrap if a variant exists for it)"
fi

#------------------------------------------------------------------------------
# 7. Bootstrap is idempotent on a configured machine
#------------------------------------------------------------------------------
if out="$("$DOTFILES_ROOT/script/bootstrap" --dry-run 2>&1)"; then
  # a pending secrets decrypt is state, not configuration; see the secrets check
  out="$(grep -v 'would: decrypt secrets' <<<"$out")"
  # A brand-new link (its target doesn't exist yet) is state too: the pull that
  # adds a link file can't have been bootstrapped yet, and failing here would
  # make gsp roll that pull back on every machine. Anything else still fails.
  pending="$(grep -E 'would: (link |create directory )' <<<"$out" || true)"
  out="$(grep -v -E 'would: (link |create directory )' <<<"$out" || true)"
  if [[ -n "$pending" ]]; then
    skp "bootstrap: $(grep -c 'would: link ' <<<"$pending") new link(s) pending" "run script/bootstrap"
    sed 's/^/      /' <<<"$pending"
  fi
  if grep -q 'would:' <<<"$out"; then
    bad "bootstrap --dry-run still has something to do:"
    grep 'would:' <<<"$out" | sed 's/^/      /'
  else
    ok "bootstrap --dry-run proposes nothing"
  fi
else
  bad "bootstrap --dry-run failed"
fi

#------------------------------------------------------------------------------
# 8. Pre-commit hook: installed here, and blocks a private key
#------------------------------------------------------------------------------
hooks_dir="$(git -C "$DOTFILES_ROOT" rev-parse --git-path hooks)"
[[ "$hooks_dir" != /* ]] && hooks_dir="$DOTFILES_ROOT/$hooks_dir"
if [[ -L "$hooks_dir/pre-commit" && "$(readlink "$hooks_dir/pre-commit")" == "$DOTFILES_ROOT/script/pre-commit" ]]; then
  ok "pre-commit hook is installed"
else
  bad "pre-commit hook is not installed (run script/bootstrap)"
fi

(
  cd "$tmp" && git init -q hooktest && cd hooktest \
    && ln -s "$DOTFILES_ROOT/script/pre-commit" .git/hooks/pre-commit \
    && printf 'AGE-SECRET-KEY-1%s\n' "$(printf 'Q%.0s' $(seq 1 40))" > leak.txt && git add leak.txt \
    && git -c user.email=t@t -c user.name=t -c commit.gpgsign=false commit -q -m leak >/dev/null 2>&1
) && bad "pre-commit hook let a private key through" || ok "pre-commit hook blocks a commit containing a private key"

# A value assigned on an indented line of the secrets file (inside an
# `if dotfiles_has_tag ...` block) must be on the blocklist too.
printf 'if dotfiles_has_tag work; then\n  alias probe_x=%s\nfi\n' "'probe-secret-value-123456'" > "$tmp/probe.secrets"
(
  cd "$tmp" && git init -q hooktest2 && cd hooktest2 \
    && ln -s "$DOTFILES_ROOT/script/pre-commit" .git/hooks/pre-commit \
    && printf 'x = "probe-secret-value-123456"\n' > leak.txt && git add leak.txt \
    && SECRETS_DEC="$tmp/probe.secrets" git -c user.email=t@t -c user.name=t -c commit.gpgsign=false commit -q -m leak >/dev/null 2>&1
) && bad "pre-commit hook let an indented secrets value through" || ok "pre-commit hook blocks a value from an indented line of the secrets file"

# A project root from the private projects file is blocked the same way.
printf 'probe:\n  root: ~/src/probe-private-root  # comment\n' > "$tmp/probe.projects"
(
  cd "$tmp" && git init -q hooktest3 && cd hooktest3 \
    && ln -s "$DOTFILES_ROOT/script/pre-commit" .git/hooks/pre-commit \
    && printf 'cd ~/src/probe-private-root\n' > leak.txt && git add leak.txt \
    && PROJECTS_PRIVATE="$tmp/probe.projects" SECRETS_DEC=/nonexistent git -c user.email=t@t -c user.name=t -c commit.gpgsign=false commit -q -m leak >/dev/null 2>&1
) && bad "pre-commit hook let a private project root through" || ok "pre-commit hook blocks a root from the private projects file"

#------------------------------------------------------------------------------
# 8b. Packages (informational only: a new Brewfile entry must not fail gsp on
#     machines that have not run script/install yet)
#------------------------------------------------------------------------------
if command -v brew >/dev/null 2>&1; then
  expected_profile_file="Brewfile.$expected_profile"
  brew list --formula 2>/dev/null > "$tmp/formulae"
  brew list --cask 2>/dev/null > "$tmp/casks"
  missing=()
  for bf in Brewfile "$expected_profile_file"; do
    [[ -f "$DOTFILES_ROOT/$bf" ]] || continue
    while IFS= read -r name; do
      grep -qx "$name" "$tmp/formulae" || missing+=("$name")
    done < <(sed -nE "s/^brew '([^']+)'.*/\1/p" "$DOTFILES_ROOT/$bf")
    while IFS= read -r name; do
      grep -qx "$name" "$tmp/casks" || missing+=("$name (cask)")
    done < <(sed -nE "s/^cask '([^']+)'.*/\1/p" "$DOTFILES_ROOT/$bf")
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    ok "every package in Brewfile and $expected_profile_file is installed"
  else
    skp "packages from Brewfile and $expected_profile_file" "${#missing[@]} not installed, run script/install: ${missing[*]}"
  fi
fi

#------------------------------------------------------------------------------
# 9. Secrets: decrypted and in sync here, and push refuses to clobber a remote change
#------------------------------------------------------------------------------
if [[ -f "$DOTFILES_ROOT/secrets.sops.yaml" ]] && command -v sops >/dev/null 2>&1; then
  # State is informational: a pull that brings new secrets, or a machine that
  # is not a recipient yet, must not make gsp roll a pull back.
  rc=0; "$DOTFILES_ROOT/bin/secrets" check || rc=$?
  case $rc in
    0) ok "secrets are decrypted and in sync with the repo" ;;
    1) skp "secrets in sync" "a pull is pending, run: secrets pull (gsp does this after a pull)" ;;
    2) skp "secrets in sync" "this machine cannot decrypt yet, see: secrets status" ;;
  esac
  cp "$DOTFILES_ROOT/secrets.sops.yaml" "$tmp/enc.yaml"
  echo "x=1" > "$tmp/dec"; echo "not-the-real-hash" > "$tmp/state"
  if SECRETS_ENC="$tmp/enc.yaml" SECRETS_DEC="$tmp/dec" SECRETS_STATE="$tmp/state" \
       "$DOTFILES_ROOT/bin/secrets" push >/dev/null 2>"$tmp/push.err"; then
    bad "secrets push overwrote a repo file that changed since the last pull"
  elif grep -q 'refusing to push' "$tmp/push.err" && cmp -s "$tmp/enc.yaml" "$DOTFILES_ROOT/secrets.sops.yaml"; then
    ok "secrets push refuses when the repo file changed since the last pull"
  else
    bad "secrets push failed for an unexpected reason: $(head -1 "$tmp/push.err")"
  fi
else
  skp "secrets" "no secrets.sops.yaml or sops not installed"
fi

if command -v sops >/dev/null 2>&1 && command -v age-keygen >/dev/null 2>&1; then
  # keygen adopts a key from an older setup instead of generating a second one
  fake="$tmp/fakehome"; mkdir -p "$fake/.age"
  age-keygen -o "$fake/.age/key.txt" 2>/dev/null
  if HOME="$fake" SOPS_AGE_KEY_FILE= "$DOTFILES_ROOT/bin/secrets" keygen >/dev/null 2>&1 \
     && cmp -s "$fake/.age/key.txt" "$fake/.config/sops/age/keys.txt"; then
    ok "secrets keygen adopts an existing ~/.age/key.txt instead of generating a new key"
  else
    bad "secrets keygen did not adopt the existing ~/.age/key.txt"
  fi
  # the public key can be read without age-keygen (sops alone is enough on a box without age)
  mkdir -p "$tmp/nobin"; ln -s "$(command -v sops)" "$tmp/nobin/sops"; ln -s "$(command -v sed)" "$tmp/nobin/sed"
  for b in bash env grep head cut tr mktemp cat cmp mv rm chmod dirname basename mkdir cp shasum sha256sum wc python3 date; do
    command -v "$b" >/dev/null 2>&1 && ln -sf "$(command -v "$b")" "$tmp/nobin/$b"
  done
  if [[ "$(PATH="$tmp/nobin" HOME="$fake" SOPS_AGE_KEY_FILE="$fake/.config/sops/age/keys.txt" "$DOTFILES_ROOT/bin/secrets" pubkey 2>/dev/null)" == age1* ]]; then
    ok "secrets pubkey works without age-keygen installed"
  else
    bad "secrets pubkey needs age-keygen"
  fi
  # pull refuses to overwrite a never-pulled local file that differs
  if [[ -f "$DOTFILES_ROOT/secrets.sops.yaml" ]] && "$DOTFILES_ROOT/bin/secrets" check >/dev/null 2>&1; then
    echo "# old local content" > "$tmp/olddec"
    rc=0; SECRETS_DEC="$tmp/olddec" SECRETS_STATE="$tmp/nostate" "$DOTFILES_ROOT/bin/secrets" pull >/dev/null 2>&1 || rc=$?
    if [[ $rc -eq 3 && "$(cat "$tmp/olddec")" == "# old local content" ]]; then
      ok "secrets pull keeps a never-pulled local file that differs from the repo"
    else
      bad "secrets pull overwrote or mishandled a never-pulled local file (rc=$rc)"
    fi
  fi
fi

#------------------------------------------------------------------------------
echo
if [[ $fail -eq 0 ]]; then
  echo "PASS: $pass checks passed, $skip skipped"
  exit 0
else
  echo "FAIL: $fail failed, $pass passed, $skip skipped"
  exit 1
fi
