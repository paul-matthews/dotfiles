#!/usr/bin/env bash
#
# Run all dotfiles installers.
#
# macOS: brew bundle on the core Brewfile, then Brewfile.<profile> (home|work
#        from ~/.dotfiles-profile), then every */install.sh.
# Linux: apt packages from linux/packages.txt (any apt-based distro), plus
#        linux/packages.pi.txt on a Raspberry Pi, then every */install.sh.
#        Package names with | alternatives are tried in order; the first one
#        apt knows about wins.

set -e

cd "$(dirname "$0")"/..

info () { printf "  [ \033[00;34m..\033[0m ] %s\n" "$1"; }
ok ()   { printf "  [ \033[00;32mOK\033[0m ] %s\n" "$1"; }
warn () { printf "  [ \033[0;33m!!\033[0m ] %s\n" "$1"; }

profile () {
  local p="home"
  if [ -r "$HOME/.dotfiles-profile" ]
  then
    p="$(tr -d '[:space:]' < "$HOME/.dotfiles-profile")"
  fi
  echo "${p:-home}"
}

is_pi () {
  if [ -r /proc/device-tree/model ] && grep -qi 'raspberry pi' /proc/device-tree/model 2>/dev/null
  then
    return 0
  fi
  [ -r "$HOME/.dotfiles-tags" ] && grep -qx pi "$HOME/.dotfiles-tags"
}

install_macos () {
  sh homebrew/install.sh
  echo "› brew bundle (Brewfile)"
  brew bundle --file=Brewfile

  local extra="Brewfile.$(profile)"
  if [ -f "$extra" ]
  then
    echo "› brew bundle ($extra)"
    brew bundle --file="$extra"
  fi
}

# apt_install_list <file>: install each line's first available package
apt_install_list () {
  local line names name installed
  while IFS= read -r line
  do
    line="${line%%#*}"
    line="$(echo "$line" | tr -d '[:space:]')"
    [ -z "$line" ] && continue
    installed=false
    IFS='|' read -ra names <<< "$line"
    for name in "${names[@]}"
    do
      if apt-cache show "$name" >/dev/null 2>&1
      then
        if sudo apt-get install -y -qq "$name" >/dev/null
        then
          ok "$name"
          installed=true
          break
        fi
      fi
    done
    [ "$installed" = true ] || warn "no installable package among: $line"
  done < "$1"
}

install_linux () {
  if [ -r /etc/os-release ]
  then
    info "linux: $(. /etc/os-release; echo "${PRETTY_NAME:-$ID} (ID=$ID ID_LIKE=${ID_LIKE:-})")"
  fi

  if ! command -v apt-get >/dev/null 2>&1
  then
    warn "apt-get not found: package install skipped; the shell config still works"
    return 0
  fi

  echo "› apt-get update"
  sudo apt-get update -qq

  echo "› apt (linux/packages.txt)"
  apt_install_list linux/packages.txt
  if is_pi && [ -f linux/packages.pi.txt ]
  then
    echo "› apt (linux/packages.pi.txt)"
    apt_install_list linux/packages.pi.txt
  fi

  # starship has no apt package on most distros; use the official installer
  if ! command -v starship >/dev/null 2>&1
  then
    echo "› starship (official installer)"
    curl -sS https://starship.rs/install.sh | sh -s -- -y >/dev/null || warn "starship install failed"
  fi
}

case "$(uname -s)" in
  Darwin) install_macos ;;
  Linux)  install_linux ;;
  *)      warn "unsupported OS $(uname -s); skipping package install" ;;
esac

# find the installers and run them iteratively
find . -name install.sh -not -path './vendor/*' | while read -r installer ; do sh -c "${installer}" ; done
