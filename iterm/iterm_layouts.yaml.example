work:
  tab_color: [32, 100, 100]
  bg_color: [20, 35, 35]
  split: horizontal
  panes:
    - size: 0.75
      command: jetski
    - size: 0.25
      command: ""

claude-dev:
  tab_color: [100, 50, 120]
  bg_color: [30, 20, 35]
  split: vertical
  panes:
    - size: 0.5
      command: claude
    - size: 0.5
      command: cd /Users/pmatthews/src/dotfiles && git status
