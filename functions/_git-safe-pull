#compdef git-safe-pull gsp

_arguments -S -A '-*' \
  '(-h --help)'{-h,--help}'[Show usage, features, and atomic rollback explanation]' \
  '(-v --verbose)'{-v,--verbose}'[Show detailed git command output]' \
  '(-n --dry-run)'{-n,--dry-run}'[Check remote status without modifying working tree or history]' \
  '(-a --auto-resolve)'{-a,--auto-resolve}'[Auto-resolve trivial merge conflicts without prompting]' \
  '--no-resolve[Disable merge conflict auto-resolution]' \
  '--no-push[Do not push upstream after synchronization]' \
  '--verify[Force test verification]' \
  '--no-verify[Skip test verification]' && ret=0

