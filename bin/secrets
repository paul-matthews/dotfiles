#!/usr/bin/env bash
#
# secrets — the SOPS + age encrypted files shared by every machine:
#
#   secrets.sops.yaml           -> ~/.localrc.secrets (shell: exports, aliases)
#   projects.private.sops.yaml  -> ~/.config/dotfiles/projects.private.yaml
#                                  (private projects, see system/projects.yaml)
#
# Every command works on each file in turn; a file not in the repo yet is skipped.
#
#   secrets pull [--force]  decrypt each file (mode 600); refuses to overwrite a
#                           differing local file that was never pulled here (an
#                           older setup) unless --force
#   secrets push [--force]  encrypt each local file that differs from the repo;
#                           refused if the repo file changed since your last pull,
#                           because encrypted files cannot be merged
#   secrets status          key, recipients, and whether local and repo are in sync
#   secrets check           exit 0 when decrypted and in sync, 1 when a pull is
#                           needed, 2 when this machine cannot decrypt yet
#   secrets keygen          create this machine's age key if it has none (adopting a
#                           key from an older setup, e.g. ~/.age/key.txt, if found), and
#                           print the public key to add as a recipient
#   secrets pubkey          print this machine's public key
#   secrets add-recipient <age1...>
#                           add a public key to .sops.yaml and re-encrypt for it
#                           (needs a machine that can already decrypt)
#
# Options: --quiet (pull/keygen: say nothing unless something is wrong)
#
# The decrypted file is plain zsh (exports, aliases) sourced by zshrc; keep it
# small and rarely edited. Each machine's private key lives at
# ~/.config/sops/age/keys.txt (override with SOPS_AGE_KEY_FILE) and should also
# be stored in 1Password.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
# The managed files, as "repo file|decrypted file|state file". SECRETS_ENC (with
# SECRETS_DEC, SECRETS_STATE) narrows it to a single file, for tests.
if [[ -n "${SECRETS_ENC:-}${SECRETS_DEC:-}${SECRETS_STATE:-}" ]]; then
  FILES=("${SECRETS_ENC:-$ROOT/secrets.sops.yaml}|${SECRETS_DEC:-$HOME/.localrc.secrets}|${SECRETS_STATE:-$HOME/.localrc.secrets.pulled}")
else
  FILES=("$ROOT/secrets.sops.yaml|$HOME/.localrc.secrets|$HOME/.localrc.secrets.pulled"
         "$ROOT/projects.private.sops.yaml|$HOME/.config/dotfiles/projects.private.yaml|$HOME/.config/dotfiles/projects.private.yaml.pulled")
fi
ENC="" DEC="" STATE=""
use_file() { IFS='|' read -r ENC DEC STATE <<<"$1"; }
CONFIG="${SECRETS_CONFIG:-$ROOT/.sops.yaml}"
CALLER_KEY_FILE="${SOPS_AGE_KEY_FILE:-}"
export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"

QUIET=false
FORCE=false
cmd="${1:-status}"
shift || true
for arg in "$@"; do
  case "$arg" in
    --quiet) QUIET=true ;;
    --force) FORCE=true ;;
  esac
done

say()  { [[ "$QUIET" == true ]] || printf '%s\n' "$1"; }
warn() { printf 'secrets: %s\n' "$1" >&2; }
die()  { warn "$1"; exit "${2:-1}"; }

# sops is enough for pull, push and adopting an existing key (it decrypts with
# age keys natively); age-keygen is only needed to generate a new key.
need_tools() {
  command -v sops >/dev/null 2>&1 || die "sops is not installed (brew install sops / apt-get install sops)" 2
}
need_age() {
  command -v age-keygen >/dev/null 2>&1 || die "age is not installed (brew install age / apt-get install age); needed only to generate a new key" 2
}

hash_of() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
  else sha256sum "$1" | cut -d' ' -f1; fi
}

public_key() {
  [[ -r "$SOPS_AGE_KEY_FILE" ]] || return 1
  if command -v age-keygen >/dev/null 2>&1; then
    age-keygen -y "$SOPS_AGE_KEY_FILE" 2>/dev/null
  else
    # age-keygen writes "# public key: age1..." into the key file; use that
    sed -nE 's/^# public key: (age1[a-z0-9]+).*/\1/p' "$SOPS_AGE_KEY_FILE" | head -1 | grep . || return 1
  fi
}

recipients() {
  # the comma-separated age: list in .sops.yaml, one per line
  sed -nE 's/^[[:space:]]*age:[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/p' "$CONFIG" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$' || true
}

is_recipient() {
  local pk; pk="$(public_key)" || return 1
  recipients | grep -qxF "$pk"
}

# An age key from an earlier setup: the caller's SOPS_AGE_KEY_FILE, the path
# ~/.localrc exports, or the old default locations. First readable one wins.
find_legacy_key() {
  local c
  local -a candidates=()
  [[ -n "$CALLER_KEY_FILE" ]] && candidates+=("$CALLER_KEY_FILE")
  if [[ -r "$HOME/.localrc" ]]; then
    c="$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?SOPS_AGE_KEY_FILE=["'"'"']?([^"'"'"'[:space:]]+).*/\2/p' "$HOME/.localrc" | tail -1)"
    [[ -n "$c" ]] && candidates+=("${c/#\~/$HOME}")
  fi
  candidates+=("$HOME/.age/key.txt" "$HOME/.config/age/keys.txt" "$HOME/Library/Application Support/sops/age/keys.txt")
  for c in "${candidates[@]}"; do
    [[ "$c" == "$SOPS_AGE_KEY_FILE" ]] && continue
    if [[ -r "$c" ]] && grep -q 'AGE-SECRET-KEY-1' "$c" 2>/dev/null; then
      printf '%s\n' "$c"; return 0
    fi
  done
  return 1
}

cmd_keygen() {
  need_tools
  if [[ -r "$SOPS_AGE_KEY_FILE" ]]; then
    say "age key present: $SOPS_AGE_KEY_FILE"
    say "public key: $(public_key)"
    return 0
  fi
  mkdir -p "$(dirname "$SOPS_AGE_KEY_FILE")"
  chmod 700 "$(dirname "$SOPS_AGE_KEY_FILE")"
  local legacy
  if legacy="$(find_legacy_key)"; then
    cp "$legacy" "$SOPS_AGE_KEY_FILE"
    chmod 600 "$SOPS_AGE_KEY_FILE"
    printf 'secrets: adopted the existing age key from %s (copied to %s)\n' "$legacy" "$SOPS_AGE_KEY_FILE"
    printf 'secrets: public key %s (%s)\n' "$(public_key)" "$(is_recipient && echo 'already a recipient' || echo 'not a recipient yet')"
    return 0
  fi
  need_age
  age-keygen -o "$SOPS_AGE_KEY_FILE" 2>/dev/null
  chmod 600 "$SOPS_AGE_KEY_FILE"
  local pk; pk="$(public_key)"
  printf 'secrets: generated this machine'"'"'s age key at %s\n' "$SOPS_AGE_KEY_FILE"
  printf 'secrets: back it up in 1Password, then have a machine that can decrypt run:\n'
  printf '           secrets add-recipient %s\n' "$pk"
}

cmd_check() {
  [[ -f "$ENC" ]] || return 0            # nothing to decrypt yet
  [[ -r "$SOPS_AGE_KEY_FILE" ]] || return 2
  is_recipient || return 2
  [[ -f "$DEC" && -f "$STATE" ]] || return 1
  [[ "$(cat "$STATE")" == "$(hash_of "$ENC")" ]] || return 1
  return 0
}

cmd_pull() {
  need_tools
  [[ -f "$ENC" ]] || { say "no $ENC in the repo yet; nothing to pull"; return 0; }
  if [[ ! -r "$SOPS_AGE_KEY_FILE" ]]; then
    warn "no age key at $SOPS_AGE_KEY_FILE; run: secrets keygen"
    return 2
  fi
  if ! is_recipient; then
    warn "this machine is not a recipient yet. Have a machine that can decrypt run:"
    warn "  secrets add-recipient $(public_key)"
    return 2
  fi
  local tmp; tmp="$(mktemp)"
  if ! sops --decrypt --input-type yaml --output-type binary "$ENC" > "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    die "could not decrypt $ENC with $SOPS_AGE_KEY_FILE" 2
  fi
  chmod 600 "$tmp"
  # A local file that was never pulled on this machine may hold content the
  # repo does not have (an older setup). Never overwrite it silently.
  if [[ -f "$DEC" && ! -f "$STATE" && "$FORCE" != true ]] && ! cmp -s "$tmp" "$DEC"; then
    rm -f "$tmp"
    warn "$DEC exists and was never pulled on this machine, and it differs from the repo."
    warn "If it holds content the repo lacks: secrets push --force (publishes it), then secrets pull."
    warn "If the repo version should win: secrets pull --force."
    return 3
  fi
  mkdir -p "$(dirname "$DEC")"
  mv "$tmp" "$DEC"
  hash_of "$ENC" > "$STATE"
  say "decrypted $ENC -> $DEC"
}

cmd_push() {
  need_tools
  [[ -f "$DEC" ]] || { say "nothing to push: $DEC does not exist"; return 0; }
  # Unchanged: leave the repo file alone (re-encrypting changes every byte)
  if [[ -f "$ENC" ]] && cmp -s <(sops --decrypt --input-type yaml --output-type binary "$ENC" 2>/dev/null) "$DEC"; then
    say "$(basename "$ENC") unchanged"
    return 0
  fi
  if [[ -f "$ENC" ]] && [[ "$FORCE" != true ]]; then
    if [[ ! -f "$STATE" ]]; then
      die "refusing to push: you have never pulled $ENC on this machine. Run: secrets pull, merge by hand, then push (or --force to overwrite)"
    fi
    if [[ "$(cat "$STATE")" != "$(hash_of "$ENC")" ]]; then
      die "refusing to push: $ENC changed since your last pull (another machine pushed). Run: secrets pull, merge the two by hand, then push (or --force to overwrite)"
    fi
  fi
  local tmp; tmp="$(mktemp)"
  if ! sops --config "$CONFIG" --encrypt --input-type binary --output-type yaml "$DEC" > "$tmp"; then
    rm -f "$tmp"; die "encryption failed"
  fi
  # round-trip check before replacing the repo file
  if ! diff -q <(sops --decrypt --input-type yaml --output-type binary "$tmp") "$DEC" >/dev/null; then
    rm -f "$tmp"; die "round-trip check failed; repo file untouched"
  fi
  mv "$tmp" "$ENC"
  hash_of "$ENC" > "$STATE"
  say "encrypted $DEC -> $ENC for $(recipients | wc -l | tr -d ' ') recipient(s); commit it"
}

cmd_add_recipient() {
  need_tools
  local pk="${1:-}"
  [[ "$pk" == age1* ]] || die "usage: secrets add-recipient age1..."
  if recipients | grep -qxF "$pk"; then say "already a recipient"; return 0; fi
  python3 - "$CONFIG" "$pk" <<'PY'
import re, sys
path, pk = sys.argv[1], sys.argv[2]
s = open(path).read()
m = re.search(r'^(\s*age:\s*)"?([^"\n]*)"?\s*$', s, re.M)
if not m:
    sys.exit("no age: line in " + path)
keys = [k.strip() for k in m.group(2).split(',') if k.strip()]
keys.append(pk)
s = s[:m.start()] + m.group(1) + '"' + ','.join(keys) + '"' + s[m.end():]
open(path, 'w').write(s)
PY
  local f
  for f in "${FILES[@]}"; do
    use_file "$f"
    if [[ -f "$ENC" ]]; then
      sops --config "$CONFIG" updatekeys --yes "$ENC" >/dev/null
      hash_of "$ENC" > "$STATE"
    fi
  done
  say "added recipient; commit .sops.yaml and the *.sops.yaml files"
}

cmd_status() {
  printf 'key file:    %s (%s)\n' "$SOPS_AGE_KEY_FILE" "$([[ -r "$SOPS_AGE_KEY_FILE" ]] && echo present || echo missing)"
  if pk="$(public_key)"; then
    printf 'public key:  %s\n' "$pk"
    printf 'recipient:   %s\n' "$(is_recipient && echo yes || echo 'NO - ask a machine that can decrypt to run: secrets add-recipient '"$pk")"
  fi
  printf 'recipients:  %s\n' "$(recipients | wc -l | tr -d ' ') in $CONFIG"
  local f rc
  for f in "${FILES[@]}"; do
    use_file "$f"
    printf 'repo file:   %s (%s)\n' "$ENC" "$([[ -f "$ENC" ]] && echo present || echo missing)"
    printf 'local file:  %s (%s)\n' "$DEC" "$([[ -f "$DEC" ]] && echo present || echo missing)"
    rc=0; cmd_check || rc=$?
    case $rc in
      0) printf 'state:       in sync\n' ;;
      1) printf 'state:       repo file changed since last pull, or never pulled: run secrets pull\n' ;;
      2) printf 'state:       this machine cannot decrypt yet\n' ;;
    esac
  done
}

# each_file <cmd>: run a per-file command over every managed file, exiting with
# the highest status any of them returned
each_file() {
  local f rc worst=0
  for f in "${FILES[@]}"; do
    use_file "$f"
    rc=0; "$1" || rc=$?
    (( rc > worst )) && worst=$rc
  done
  return $worst
}

case "$cmd" in
  pubkey)        public_key || die "no readable key at $SOPS_AGE_KEY_FILE" 2 ;;
  pull)          each_file cmd_pull ;;
  push)          each_file cmd_push ;;
  status)        cmd_status ;;
  check)         each_file cmd_check ;;
  keygen)        cmd_keygen ;;
  add-recipient) cmd_add_recipient "$@" ;;
  -h|--help|help) sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$cmd' (pull|push|status|check|keygen|add-recipient)" ;;
esac
