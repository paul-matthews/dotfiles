#!/usr/bin/env bash
set -eo pipefail

# git-vault-save: Automated Git snapshot and cloud push helper for Obsidian / Cloud Storage vaults.
# Supports detached GIT_DIR and device-specific branching.

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BLUE}▶ Starting automated vault Git snapshot...${NC}"

# ⚡ Check for custom repository-specific sync logic and delegate
if [ -f "./scripts/sync_vault.sh" ]; then
    echo -e "  • ${GREEN}⚡ Custom repository sync script detected. Delegating execution...${NC}"
    exec "./scripts/sync_vault.sh" "$@"
fi

# Resolve working vault path
VAULT_PATH="${1:-$PWD}"
if [ ! -d "$VAULT_PATH" ]; then
    echo -e "${RED}✘ Error: Directory '$VAULT_PATH' does not exist.${NC}"
    exit 1
fi

cd "$VAULT_PATH"

# Verify active Git repository
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "${RED}✘ Error: '$VAULT_PATH' is not an active Git repository.${NC}"
    exit 1
fi

# Derive sanitized device hostname for branch allocation
HOSTNAME_RAW=$(hostname -s 2>/dev/null || hostname)
DEVICE_NAME="${HOSTNAME_RAW//[^a-zA-Z0-9]/_}"
DEVICE_BRANCH="history/${DEVICE_NAME//_/-}"

echo -e "  • Active Device:  ${YELLOW}${DEVICE_NAME}${NC}"
echo -e "  • Target Branch:  ${YELLOW}${DEVICE_BRANCH}${NC}"
echo -e "  • Remote Repo:    ${YELLOW}$(git remote get-url origin 2>/dev/null || echo 'origin not set')${NC}"

# Ensure we are on our active device-specific branch
if git show-ref --verify --quiet "refs/heads/$DEVICE_BRANCH"; then
    git checkout -q "$DEVICE_BRANCH"
else
    echo -e "  • Initializing new device branch '${DEVICE_BRANCH}'..."
    git checkout -q -b "$DEVICE_BRANCH"
fi

# Interrogate workspace for dirty state
CHANGES=$(git status --porcelain)

if [ -z "$CHANGES" ]; then
    echo -e "${GREEN}✔ No changes detected in vault. Everything is fully up to date!${NC}"
    exit 0
fi

# Compile summary stats
MODIFIED_COUNT=$(echo "$CHANGES" | grep -c "^.[M] " || true)
UNTRACKED_COUNT=$(echo "$CHANGES" | grep -c "^??" || true)
DELETED_COUNT=$(echo "$CHANGES" | grep -c "^.[D] " || true)

TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")
COMMIT_MSG="[${DEVICE_NAME}] Snapshot: ${MODIFIED_COUNT} modified, ${UNTRACKED_COUNT} added, ${DELETED_COUNT} deleted (${TIMESTAMP})"

echo -e "  • Staging non-ignored working files..."
git add -A

echo -e "  • Recording Commit: \"${COMMIT_MSG}\"..."
git commit -q -m "$COMMIT_MSG"

echo -e "  • Pushing history to Depot endpoint..."
if git push -u origin "$DEVICE_BRANCH" -q; then
    echo -e "${GREEN}✔ Snapshot successfully recorded and pushed to GitHub Enterprise!${NC}"
else
    echo -e "${RED}✘ Error: Failed to push to remote endpoint. Verify network or SSH authentication.${NC}"
    exit 1
fi
