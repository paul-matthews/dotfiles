#!/usr/bin/env bash
# ==============================================================================
# git-safe-pull (gsp)
#
# Safe, atomic git pull with in-memory conflict auto-resolution, automatic rollback,
# stash preservation, signing key verification, and push-by-default.
#
# WHY THIS EXISTS:
# Standard `git pull --rebase --autostash` can fail unpredictably when background
# auto-commits (or remote pushes) collide with uncommitted local work. In particular,
# when Phase 3 (stash pop) encounters a conflict, the rebase has already completed—
# leaving the repository in a broken state where `git rebase --abort` fails with
# "fatal: No rebase in progress?".
#
# WHAT THIS COMMAND GUARANTEES:
# 1. ATOMICITY: Either the pull and rebase/merge succeed 100%, or your workspace is
#    cleanly rolled back to the exact pre-command state (commit + uncommitted edits).
# 2. ZERO LOSS: Uncommitted edits (including untracked files) are stashed with a
#    unique ref and never dropped unless cleanly reapplied. Backup refs are always
#    created before any mutation.
# 3. TRIVIAL CONFLICT AUTO-RESOLUTION: Conflicting lines matching rules declared in
#    .gsp-merge.toml are resolved in memory without touching the worktree.
# 4. SIGNING AWARE: Fast-forwards when no local commits exist (zero signing prompts).
#    Rebases and signs commits when local commits exist; handles key failures gracefully.
# 5. PORTABILITY: Tested and portable across macOS and Linux shells.
# ==============================================================================

set -eo pipefail

GSP_BIN="$(cd "$(dirname "$(realpath "$0")")" && pwd)"

show_help() {
  cat << 'EOF'
Usage: gsp [options]
       git safe-pull [options]

Atomic git synchronization with auto-resolution of trivial merge conflicts,
push-by-default, and rollback protection against broken rebases or test failures.

Options:
  -h, --help          Show this help message and explanation
  -v, --verbose       Show full git output during execution
  -n, --dry-run       Check remote status without modifying working tree or history
  -a, --auto-resolve  Auto-resolve trivial merge conflicts without prompting
      --no-resolve    Disable merge conflict auto-resolution (rebase only)
      --no-push       Do not push upstream after synchronization
      --verify        Force test verification (pass --force to gsp-verify)
      --no-verify     Skip test verification (same as GSP_NO_VERIFY=1)

Environment variables:
  GSP_AUTO_RESOLVE=1  Same as --auto-resolve
  GSP_NO_PUSH=1       Same as --no-push
  GSP_NO_VERIFY=1     Same as --no-verify

Exit codes:
  0  Synced successfully (and pushed if ahead)
  1  Aborted or rolled back; workspace left untouched
  2  Usage, configuration, or invocation error
  3  Synced locally, but push upstream failed
  4  Credentials or signing key locked in non-interactive session

Recovery:
  If a rollback occurs, your pre-command state is automatically restored.
  Backup refs are preserved under refs/gsp/backup/<epoch>-<pid>/{head,stash}.
  Manual recovery command:
    git reset --hard refs/gsp/backup/<id>/head && git stash apply refs/gsp/backup/<id>/stash

How it works:
  1. Validates repository health, checks for active merges/rebases, and acquires lock.
  2. Safely stashes uncommitted work and creates backup refs before any mutation.
  3. Fetches upstream changes under a 60s watchdog (non-interactive auth failure -> exit 4).
  4. If already up to date, verifies via gsp-verify and exits cleanly.
  5. If commits are ahead, probes SSH signing key (locked non-interactive -> exit 4).
  6. If conflicts occur, uses git-meta-resolve in-memory to auto-resolve trivial conflicts
     into a merge commit without touching the working tree.
  7. Re-applies uncommitted local edits onto the updated branch.
  8. Syncs secrets and verifies checkout via gsp-verify (--changed-from PRE_HEAD).
  9. Pushes branch upstream unless --no-push (retries non-ff up to 3 times; parks on failure).
 10. Removes backup refs and releases lock on clean completion.
EOF
}

VERBOSE=false
DRY_RUN=false
AUTO_RESOLVE=false
NO_RESOLVE=false
NO_PUSH=false
VERIFY_FORCE=false
PASSTHROUGH_ARGS=()

if [[ "${GSP_AUTO_RESOLVE:-}" == "1" ]]; then
  AUTO_RESOLVE=true
fi
if [[ "${GSP_NO_PUSH:-}" == "1" ]]; then
  NO_PUSH=true
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--verbose)
      VERBOSE=true
      shift
      ;;
    -n|--dry-run)
      DRY_RUN=true
      shift
      ;;
    -a|--auto-resolve)
      AUTO_RESOLVE=true
      shift
      ;;
    --no-resolve)
      NO_RESOLVE=true
      shift
      ;;
    --no-push)
      NO_PUSH=true
      shift
      ;;
    --verify)
      VERIFY_FORCE=true
      shift
      ;;
    --no-verify)
      export GSP_NO_VERIFY=1
      shift
      ;;
    -*)
      echo -e "\033[1;31m❌ Error: Unknown option '$1'.\033[0m" >&2
      show_help >&2
      exit 2
      ;;
    *)
      PASSTHROUGH_ARGS+=("$1")
      shift
      ;;
  esac
done

# Interactive detection & non-interactive hardening
IS_INTERACTIVE=false
if [[ -t 0 && -t 1 ]]; then
  IS_INTERACTIVE=true
else
  export GIT_TERMINAL_PROMPT=0
  export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes -o ConnectTimeout=10"
fi

# 60s Watchdog runner (pure bash)
run_with_watchdog() {
  local timeout="$1"
  shift
  "$@" &
  local cmd_pid=$!
  (
    sleep "$timeout"
    kill -TERM "$cmd_pid" 2>/dev/null || true
    sleep 2
    kill -KILL "$cmd_pid" 2>/dev/null || true
  ) >/dev/null 2>&1 &
  local watcher_pid=$!

  local exit_code=0
  wait "$cmd_pid" 2>/dev/null || exit_code=$?
  kill -TERM "$watcher_pid" 2>/dev/null || true
  kill -KILL "$watcher_pid" 2>/dev/null || true
  wait "$watcher_pid" 2>/dev/null || true
  return $exit_code
}

# 1. Verify we are in a git repo
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo -e "\033[1;31m❌ Error: Not inside a git repository.\033[0m" >&2
  exit 1
fi

GIT_DIR="$(git rev-parse --git-dir)"

# Pre-flight check: ensure no active rebase, merge, or cherry-pick
if [[ -d "$GIT_DIR/rebase-merge" || -d "$GIT_DIR/rebase-apply" ]]; then
  echo -e "\033[1;33m⚠️  A rebase is already in progress. Resolve with 'git rebase --continue' or 'git rebase --abort'.\033[0m" >&2
  exit 1
fi
if [[ -f "$GIT_DIR/MERGE_HEAD" ]]; then
  echo -e "\033[1;33m⚠️  A merge is already in progress. Resolve or abort with 'git merge --abort'.\033[0m" >&2
  exit 1
fi
if [[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ]]; then
  echo -e "\033[1;33m⚠️  A cherry-pick is already in progress. Resolve or abort with 'git cherry-pick --abort'.\033[0m" >&2
  exit 1
fi

LOCK_DIR="$GIT_DIR/gsp.lock"
PID_FILE="$LOCK_DIR/pid"

acquire_lock() {
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    local lock_pid=""
    if [[ -f "$PID_FILE" ]]; then
      lock_pid="$(cat "$PID_FILE" 2>/dev/null || echo "")"
    fi
    local stale=false
    if [[ -n "$lock_pid" ]]; then
      kill -0 "$lock_pid" 2>/dev/null || stale=true
    elif [[ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin +1 2>/dev/null)" ]]; then
      # No pid file: a run died between mkdir and writing it. Give a live run's
      # sub-millisecond window plenty of margin, then reclaim.
      stale=true
    fi
    if [[ "$stale" == true ]]; then
      echo -e "\033[33m⚠️  Removing stale lock from PID ${lock_pid:-unknown}...\033[0m" >&2
      rm -rf "$LOCK_DIR" 2>/dev/null || true
      if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        echo -e "\033[1;31m❌ Error: another gsp is running.\033[0m" >&2
        exit 1
      fi
    else
      echo -e "\033[1;31m❌ Error: another gsp is running.\033[0m" >&2
      exit 1
    fi
  fi
  echo $$ > "$PID_FILE"
}

release_lock() {
  if [[ -d "$LOCK_DIR" ]]; then
    local lock_pid=""
    if [[ -f "$PID_FILE" ]]; then
      lock_pid="$(cat "$PID_FILE" 2>/dev/null || echo "")"
    fi
    if [[ -z "$lock_pid" || "$lock_pid" == "$$" ]]; then
      rm -rf "$LOCK_DIR" 2>/dev/null || true
    fi
  fi
}

acquire_lock

EPOCH="$(date +%s)"
BACKUP_ID="${EPOCH}-$$"

BACKUP_HEAD_SET=false
BACKUP_STASH_SET=false

# Uncommitted work is the only irreplaceable data: back it up as soon as it is stashed.
# Only the FIRST stash is recorded: it is based on PRE_HEAD, so the printed recovery
# command always applies cleanly. Later re-stashes stay in the stash list until applied.
backup_stash() {
  [[ "$BACKUP_STASH_SET" == true ]] && return 0
  git update-ref "refs/gsp/backup/${BACKUP_ID}/stash" "$STASH_SHA"
  BACKUP_STASH_SET=true
}

# Called immediately before the first command that moves the branch or touches the
# worktree (ff, rebase, ff to the merge commit). The read-only paths (up to date,
# dry-run, aborts before mutation) never need it, which keeps them fast.
ensure_backup_head() {
  [[ "$BACKUP_HEAD_SET" == true ]] && return 0
  git update-ref "refs/gsp/backup/${BACKUP_ID}/head" "$PRE_HEAD"
  BACKUP_HEAD_SET=true
  prune_backup_refs
}

prune_backup_refs() {
  local now
  now="$(date +%s)"
  local cutoff=$(( now - 2592000 )) # 30 days = 30 * 86400
  local ref
  while IFS= read -r ref; do
    [[ -z "$ref" ]] && continue
    local subref="${ref#refs/gsp/*/}"
    local ref_epoch="${subref%%-*}"
    if [[ "$ref_epoch" =~ ^[0-9]+$ ]]; then
      if (( ref_epoch < cutoff )); then
        git update-ref -d "$ref" 2>/dev/null || true
      fi
    fi
  done < <(git for-each-ref --format='%(refname)' refs/gsp/ 2>/dev/null || true)
}

remove_backup_refs() {
  local cmds=""
  [[ "$BACKUP_HEAD_SET" == true ]] && cmds+="delete refs/gsp/backup/${BACKUP_ID}/head"$'\n'
  [[ "$BACKUP_STASH_SET" == true ]] && cmds+="delete refs/gsp/backup/${BACKUP_ID}/stash"$'\n'
  [[ -n "$cmds" ]] || return 0
  printf '%s' "$cmds" | git update-ref --stdin 2>/dev/null || true
}

drop_stash_by_sha() {
  local target_sha="$1"
  if [[ -n "$target_sha" ]]; then
    local ref
    # `|| true`: grep finds nothing when the stash is already gone; under pipefail that
    # must not trip the ERR trap (this runs inside rollback, which has no trap left).
    ref="$(git stash list --format="%gd %H" | grep "$target_sha" | awk '{print $1}' | head -n 1 || true)"
    if [[ -n "$ref" ]]; then
      git stash drop "$ref" >/dev/null 2>&1 || true
    fi
  fi
}

# stash_worktree <message>: park every uncommitted change (tracked + untracked).
# Clean tree → no-op (STASH_SHA untouched). A stash is only adopted if refs/stash
# actually moved, so an older, unrelated stash is never mistaken for ours. If
# `git stash push` fails we STOP at once without resetting anything: a reset after
# a failed stash is the one way to lose uncommitted work.
stash_worktree() {
  [[ -n "$(git status --porcelain)" ]] || return 0
  local before after
  before="$(git rev-parse -q --verify refs/stash || true)"
  if git stash push -u -q -m "$1" >/dev/null 2>&1; then
    after="$(git rev-parse -q --verify refs/stash || true)"
    if [[ -n "$after" && "$after" != "$before" ]]; then
      STASH_CREATED=true
      STASH_SHA="$after"
      backup_stash
      return 0
    fi
  fi
  trap - INT TERM HUP EXIT ERR
  echo -e "\n\033[1;31m❌ Could not stash uncommitted edits; stopping without touching your worktree.\033[0m" >&2
  echo -e "\033[33m💡 Your files are exactly as they are now. Check permissions / git status, then re-run.\033[0m" >&2
  print_recovery
  release_lock
  exit 1
}


# Print the exact command that restores the pre-run state from the backup refs
print_recovery() {
  [[ -n "$BACKUP_ID" ]] || return 0
  local parts=()
  [[ "$BACKUP_HEAD_SET" == true ]] && parts+=("git reset --hard refs/gsp/backup/${BACKUP_ID}/head")
  [[ "$BACKUP_STASH_SET" == true ]] && parts+=("git stash apply refs/gsp/backup/${BACKUP_ID}/stash")
  [[ ${#parts[@]} -gt 0 ]] || return 0
  local cmd="${parts[0]}"
  [[ ${#parts[@]} -gt 1 ]] && cmd+=" && ${parts[1]}"
  echo -e "\033[33m💡 Recovery command: ${cmd}\033[0m" >&2
}

rollback() {
  local reason="$1"
  local exit_code="${2:-1}"
  trap - INT TERM HUP EXIT ERR
  echo -e "\n\033[1;31m⚠️  ${reason}\033[0m" >&2
  echo -e "\033[33m↩️  Restoring workspace to pre-command state (${PRE_HEAD:0:7})...\033[0m" >&2

  # Abort rebase if in progress
  if [[ -d "$GIT_DIR/rebase-merge" || -d "$GIT_DIR/rebase-apply" ]]; then
    git rebase --abort >/dev/null 2>&1 || true
  fi

  # Abort merge if in progress
  if [[ -f "$GIT_DIR/MERGE_HEAD" ]]; then
    git merge --abort >/dev/null 2>&1 || true
  fi

  # Clear any rerere uncommitted cache created during failed attempts
  git rerere clear >/dev/null 2>&1 || true

  # Park anything still in the worktree (e.g. edits re-applied after the pull) so the
  # reset below cannot discard it; stops without resetting if that stash fails.
  # Skipped after a failed stash apply: that state is rebuilt from STASH_SHA.
  [[ "${APPLY_FAILED:-false}" == true ]] || stash_worktree "safe-pull-rollback-${BACKUP_ID}"

  # Reset branch pointer and working tree to PRE_HEAD
  git reset --hard "$PRE_HEAD" >/dev/null 2>&1 || true

  # Reapply stashed work back onto PRE_HEAD
  if [[ "$STASH_CREATED" == true && -n "$STASH_SHA" ]]; then
    if git stash apply "$STASH_SHA" >/dev/null 2>&1; then
      drop_stash_by_sha "$STASH_SHA"
      echo -e "\033[32m📦 Uncommitted local edits successfully restored onto pre-command state.\033[0m" >&2
    else
      echo -e "\033[1;33m⚠️  Could not automatically pop stash; edits preserved in git stash (${STASH_SHA:0:7}).\033[0m" >&2
    fi
  fi

  if [[ -n "$BACKUP_ID" ]]; then
    print_recovery
  fi

  echo -e "\033[1;32m✅ Workspace safely restored to original state.\033[0m" >&2
  release_lock
  exit "$exit_code"
}

abort() {
  local reason="$1"
  local exit_code="${2:-1}"
  trap - INT TERM HUP EXIT ERR
  if [[ -n "$reason" ]]; then
    echo -e "\n\033[1;31m⚠️  ${reason}\033[0m" >&2
  fi

  if [[ "$STASH_CREATED" == true && -n "$STASH_SHA" ]]; then
    if git stash apply "$STASH_SHA" >/dev/null 2>&1; then
      drop_stash_by_sha "$STASH_SHA"
      echo -e "\033[32m📦 Uncommitted local edits successfully restored onto pre-command state.\033[0m" >&2
    else
      echo -e "\033[1;33m⚠️  Could not automatically pop stash; edits preserved in git stash (${STASH_SHA:0:7}).\033[0m" >&2
    fi
  fi

  if [[ -n "$BACKUP_ID" ]]; then
    print_recovery
  fi

  release_lock
  exit "$exit_code"
}

PRE_HEAD="$(git rev-parse HEAD)"

# From here on any interruption or unexpected command failure restores PRE_HEAD.
trap 'rollback "Command interrupted or terminated unexpectedly." 1' INT TERM HUP
trap 'rollback "Unexpected error at line ${LINENO}; nothing is lost." 1' ERR
CURRENT_BRANCH="$(git symbolic-ref --short -q HEAD 2>/dev/null || true)"
if [[ -z "$CURRENT_BRANCH" ]]; then
  trap - INT TERM HUP ERR
  echo -e "\033[1;31m❌ Error: detached HEAD; check out a branch before running gsp.\033[0m" >&2
  release_lock
  exit 1
fi
UPSTREAM="$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo "")"

if [[ -z "$UPSTREAM" ]]; then
  # Check if origin/<branch> exists
  if git rev-parse --verify "origin/${CURRENT_BRANCH}" >/dev/null 2>&1; then
    echo -e "\033[1;33m⚠️  Branch '${CURRENT_BRANCH}' has no upstream tracking branch set, but 'origin/${CURRENT_BRANCH}' exists.\033[0m" >&2
    echo -e "\033[33m💡 Setting upstream tracking to origin/${CURRENT_BRANCH}...\033[0m" >&2
    git branch --set-upstream-to="origin/${CURRENT_BRANCH}" "${CURRENT_BRANCH}" >/dev/null 2>&1 || true
    UPSTREAM="origin/${CURRENT_BRANCH}"
  else
    echo -e "\033[1;31m❌ Error: Branch '${CURRENT_BRANCH:-HEAD}' has no upstream tracking branch.\033[0m" >&2
    echo -e "\033[33m💡 Set upstream with: git push -u origin ${CURRENT_BRANCH:-main}\033[0m" >&2
    release_lock
    exit 1
  fi
fi

REMOTE_NAME="${UPSTREAM%%/*}"
REMOTE_BRANCH="${UPSTREAM#*/}"

STASH_CREATED=false
STASH_SHA=""

# 2. Stash uncommitted work (including untracked files); backed up at once by the
# helper. The HEAD backup is taken right before the first mutation.
stash_worktree "safe-pull-autostash-${EPOCH}-$$"
if [[ -n "$STASH_SHA" ]]; then
  echo -e "\033[34m📦 Stashed uncommitted local edits (${STASH_SHA:0:7})...\033[0m"
fi

check_signing_probe() {
  local gpgsign
  gpgsign="$(git config --bool commit.gpgsign 2>/dev/null || echo "false")"
  [[ "$gpgsign" == "true" ]] || return 0

  local gpgformat
  gpgformat="$(git config --get gpg.format 2>/dev/null || echo "")"
  [[ "$gpgformat" == "ssh" ]] || return 0

  local signing_key
  signing_key="$(git config --get user.signingkey 2>/dev/null || echo "")"
  [[ -n "$signing_key" ]] || return 0

  local probe_passed=false
  local ssh_add_keys
  ssh_add_keys="$(ssh-add -L 2>/dev/null || echo "")"

  if [[ "$signing_key" == key::* ]]; then
    local literal="${signing_key#key::}"
    local b64
    b64="$(echo "$literal" | awk '{if ($2 != "") print $2; else print $1}')"
    if [[ -n "$ssh_add_keys" ]]; then
      if echo "$ssh_add_keys" | grep -F -q "$literal" || { [[ -n "$b64" ]] && echo "$ssh_add_keys" | grep -F -q "$b64"; }; then
        probe_passed=true
      fi
    fi
  else
    local key_path="${signing_key/#\~/$HOME}"
    local pub_path=""
    local priv_path=""

    if [[ "$key_path" == *.pub ]]; then
      pub_path="$key_path"
      priv_path="${key_path%.pub}"
    else
      priv_path="$key_path"
      if [[ -f "${key_path}.pub" ]]; then
        pub_path="${key_path}.pub"
      fi
    fi

    # Check if public key base64 appears in ssh-add -L
    if [[ -n "$pub_path" && -f "$pub_path" && -n "$ssh_add_keys" ]]; then
      local b64
      b64="$(awk '{print $2}' "$pub_path" 2>/dev/null || echo "")"
      if [[ -n "$b64" ]] && echo "$ssh_add_keys" | grep -F -q "$b64"; then
        probe_passed=true
      fi
    fi

    # Or check if private key opens without a passphrase
    if [[ "$probe_passed" == false && -n "$priv_path" && -f "$priv_path" ]]; then
      if ssh-keygen -y -P "" -f "$priv_path" </dev/null >/dev/null 2>&1; then
        probe_passed=true
      fi
    fi
  fi

  if [[ "$probe_passed" == false ]]; then
    if [[ "$IS_INTERACTIVE" == false ]]; then
      echo -e "\033[1;31m🔑 Commit signing key is locked or unavailable in non-interactive session.\033[0m" >&2
      echo -e "\033[33m💡 Hint: unlock your key: ssh-add\033[0m" >&2
      rollback "Signing key locked or unavailable in non-interactive session." 4
    else
      echo -e "\033[33m⚠️  Signing key not found in ssh-agent; interactive passphrase prompt may follow.\033[0m" >&2
    fi
  fi
  return 0
}

run_verify() {
  local verify_cmd=("$GSP_BIN/gsp-verify")
  if [[ "$VERIFY_FORCE" == true ]]; then
    verify_cmd+=("--force")
  fi
  if [[ $# -gt 0 ]]; then
    verify_cmd+=("$@")
  fi
  "${verify_cmd[@]}"
}

AUTO_RESOLVED=false
MERGE_COMMIT=""
PUSH_ATTEMPTS=0
MAX_PUSH_ATTEMPTS=3

while true; do
  # In retry attempts: ensure any uncommitted edits are stashed
  if [[ "$PUSH_ATTEMPTS" -gt 0 ]]; then
    stash_worktree "safe-pull-autostash-${EPOCH}-$$"
  fi

  # 3. Fetch upstream remote under 60s watchdog
  echo -e "\033[34m📡 Fetching ${UPSTREAM}...\033[0m"
  FETCH_OUTPUT=""
  if ! FETCH_OUTPUT="$(run_with_watchdog 60 git fetch "$REMOTE_NAME" "$REMOTE_BRANCH" "${PASSTHROUGH_ARGS[@]}" 2>&1)"; then
    echo "$FETCH_OUTPUT" >&2
    if [[ "$IS_INTERACTIVE" == false ]] && echo "$FETCH_OUTPUT" | grep -qiE "Permission denied|publickey|passphrase|Host key verification|could not read Username"; then
      echo -e "\033[33m💡 Hint: unlock your key: ssh-add\033[0m" >&2
      rollback "Fetch authentication failed." 4
    else
      rollback "Failed to fetch from remote '$REMOTE_NAME' (check network or authentication)." 1
    fi
  fi
  if [[ "$VERBOSE" == true && -n "$FETCH_OUTPUT" ]]; then
    echo "$FETCH_OUTPUT"
  fi

  UPSTREAM_HASH="$(git rev-parse "$UPSTREAM")"

  # 4. Check if already up to date
  if [[ "$PRE_HEAD" == "$UPSTREAM_HASH" ]]; then
    if [[ "$STASH_CREATED" == true && -n "$STASH_SHA" ]]; then
      git stash apply "$STASH_SHA" >/dev/null 2>&1 && drop_stash_by_sha "$STASH_SHA"
    fi
    trap - INT TERM HUP EXIT ERR
    echo -e "\033[1;32m✨ Already up to date with ${UPSTREAM} (${UPSTREAM_HASH:0:7}).\033[0m"
    if ! run_verify; then
      echo -e "\033[1;31m❌ script/test fails on the current checkout (nothing was changed).\033[0m" >&2
      release_lock
      exit 1
    fi
    remove_backup_refs
    release_lock
    exit 0
  fi

  # 5. Check divergence & signing probe
  LOCAL_AHEAD_COUNT="$(git rev-list --count "${UPSTREAM}..HEAD")"

  if [[ "$LOCAL_AHEAD_COUNT" -gt 0 ]]; then
    check_signing_probe
  fi

  # 6. Apply updates
  if [[ "$LOCAL_AHEAD_COUNT" -eq 0 ]]; then
    # Pure fast-forward
    if [[ "$DRY_RUN" == true ]]; then
      echo -e "\033[33m🔍 Dry-run mode: Updates available from ${UPSTREAM} (${UPSTREAM_HASH:0:7}). Would fast-forward. No changes applied.\033[0m"
      if [[ "$STASH_CREATED" == true && -n "$STASH_SHA" ]]; then
        git stash apply "$STASH_SHA" >/dev/null 2>&1 && drop_stash_by_sha "$STASH_SHA"
      fi
      release_lock
      remove_backup_refs
      trap - INT TERM HUP EXIT ERR
      exit 0
    fi

    ensure_backup_head
    echo -e "\033[34m⏩ Fast-forwarding branch to ${UPSTREAM_HASH:0:7}...\033[0m"
    if ! git merge --ff-only "$UPSTREAM_HASH" >/dev/null 2>&1; then
      rollback "Fast-forward merge failed unexpectedly." 1
    fi
  else
    # LOCAL_AHEAD_COUNT > 0
    MERGE_TREE_CLEAN=false
    RESOLVE_TRIED=false

    if [[ "$NO_RESOLVE" == false ]]; then
      RESOLVE_TRIED=true
      if git merge-tree --write-tree HEAD "$UPSTREAM_HASH" >/dev/null 2>&1; then
        MERGE_TREE_CLEAN=true
      fi
    fi

    if [[ "$RESOLVE_TRIED" == true && "$MERGE_TREE_CLEAN" == false ]]; then
      # Merge conflict encountered. Run git-meta-resolve plan --json
      echo -e "\033[34m🔍 Checking if merge conflicts can be automatically resolved...\033[0m"
      PLAN_JSON=""
      PLAN_EXIT=0
      PLAN_JSON="$("$GSP_BIN/git-meta-resolve" plan --ours HEAD --theirs "$UPSTREAM_HASH" --json 2>&1)" || PLAN_EXIT=$?

      if [[ "$PLAN_EXIT" -eq 2 ]]; then
        echo "$PLAN_JSON" >&2
        rollback "git-meta-resolve failed with configuration or git error." 2
      fi

      IS_RESOLVABLE="$(python3 -c 'import sys, json; data = json.loads(sys.argv[1]); print("true" if data.get("resolvable") else "false")' "$PLAN_JSON" 2>/dev/null || echo "false")"

      if [[ "$IS_RESOLVABLE" != "true" ]]; then
        echo -e "\n\033[1;31m💥 Conflicts cannot be automatically resolved:\033[0m" >&2
        python3 -c '
import sys, json
try:
    data = json.loads(sys.argv[1])
    for f in data.get("files", []):
        if not f.get("resolvable"):
            print(f"   • {f.get(\"path\")}: {f.get(\"reason\", \"unresolvable conflict\")}")
except Exception:
    pass
' "$PLAN_JSON" >&2
        echo -e "\033[33m💡 Workspace left untouched. Resolve manually or rebase.\033[0m" >&2
        abort "Merge conflicts are not resolvable." 1
      fi

      # Check consent: --auto-resolve | GSP_AUTO_RESOLVE=1 | plan .auto
      PLAN_AUTO="$(python3 -c 'import sys, json; print("true" if json.loads(sys.argv[1]).get("auto") else "false")' "$PLAN_JSON" 2>/dev/null || echo "false")"
      CONSENT=false
      if [[ "$AUTO_RESOLVE" == true || "${GSP_AUTO_RESOLVE:-}" == "1" || "$PLAN_AUTO" == "true" ]]; then
        CONSENT=true
      fi

      SUMMARY_LINES="$(python3 -c '
import sys, json
try:
    data = json.loads(sys.argv[1])
    for s in data.get("summary", []):
        print(s)
except Exception:
    pass
' "$PLAN_JSON" 2>/dev/null || echo "")"

      if [[ "$CONSENT" == false ]]; then
        if [[ "$IS_INTERACTIVE" == true ]]; then
          echo -e "\033[34mℹ️  The following trivial merge conflicts can be automatically resolved:\033[0m"
          echo "$SUMMARY_LINES" | sed 's/^/   • /'
          read -r -p "Apply auto-resolution? [Y/n] " REPLY
          if [[ "$REPLY" =~ ^[Nn] ]]; then
            echo -e "\033[33mAborted by user.\033[0m" >&2
            abort "Auto-resolution aborted by user." 1
          fi
          CONSENT=true
        else
          echo -e "\033[1;33m⚠️  Auto-resolution requires consent (run interactively, pass -a/--auto-resolve, or set auto=true in .gsp-merge.toml).\033[0m" >&2
          abort "Auto-resolution not consented in non-interactive session." 1
        fi
      fi

      # Dry-run check
      if [[ "$DRY_RUN" == true ]]; then
        echo -e "\033[33m🔍 Dry-run mode: Would auto-resolve conflicts:\033[0m"
        echo "$SUMMARY_LINES" | sed 's/^/   • /'
        if [[ "$STASH_CREATED" == true && -n "$STASH_SHA" ]]; then
          git stash apply "$STASH_SHA" >/dev/null 2>&1 && drop_stash_by_sha "$STASH_SHA"
        fi
        release_lock
        remove_backup_refs
        trap - INT TERM HUP EXIT ERR
        exit 0
      fi

      MERGE_TREE="$(python3 -c 'import sys, json; print(json.loads(sys.argv[1]).get("tree") or "")' "$PLAN_JSON" 2>/dev/null || echo "")"
      if [[ -z "$MERGE_TREE" ]]; then
        rollback "Failed to obtain resolved tree from git-meta-resolve." 1
      fi

      # Build commit message
      MSG_FILE="$(mktemp "${TMPDIR:-/tmp}/gsp-msg.XXXXXX")"
      python3 -c '
import sys, json
plan = json.loads(sys.argv[1])
upstream = sys.argv[2]
branch = sys.argv[3]
lines = [f"Merge {upstream} into {branch} (gsp auto-resolved)", ""]
for s in plan.get("summary", []):
    lines.append(f"Gsp-Auto-Resolved: {s}")
print("\n".join(lines))
' "$PLAN_JSON" "$UPSTREAM" "${CURRENT_BRANCH:-HEAD}" > "$MSG_FILE"

      COMMIT_SIGN_FLAG=()
      if [[ "$(git config --bool commit.gpgsign 2>/dev/null)" == "true" ]]; then
        COMMIT_SIGN_FLAG+=("-S")
      fi

      echo -e "\033[34m🔀 Creating auto-resolved merge commit...\033[0m"
      if ! MERGE_COMMIT="$(git -c rerere.enabled=false commit-tree "$MERGE_TREE" -p HEAD -p "$UPSTREAM_HASH" "${COMMIT_SIGN_FLAG[@]}" -F "$MSG_FILE" 2>&1)"; then
        rm -f "$MSG_FILE"
        echo "$MERGE_COMMIT" >&2
        rollback "Failed to create auto-resolved merge commit." 1
      fi
      rm -f "$MSG_FILE"

      ensure_backup_head
      if ! git merge --ff-only "$MERGE_COMMIT" >/dev/null 2>&1; then
        rollback "Failed to fast-forward branch to auto-resolved merge commit." 1
      fi
      AUTO_RESOLVED=true

      # Append resolution audit log
      mkdir -p "$GIT_DIR/gsp"
      python3 -c '
import sys, json, time
try:
    plan = json.loads(sys.argv[1])
    commit = sys.argv[2]
    now = int(time.time())
    written = False
    for f in plan.get("files", []):
        for l in f.get("lines", []):
            entry = {
                "timestamp": now,
                "commit": commit,
                "path": f.get("path"),
                "rule": l.get("rule"),
                "base": l.get("base"),
                "ours": l.get("ours"),
                "theirs": l.get("theirs"),
                "result": l.get("result"),
            }
            print(json.dumps(entry))
            written = True
    if not written and plan.get("summary"):
        for s in plan.get("summary", []):
            print(json.dumps({"timestamp": now, "commit": commit, "summary": s}))
except Exception:
    pass
' "$PLAN_JSON" "$MERGE_COMMIT" >> "$GIT_DIR/gsp/log" 2>/dev/null || true

    else
      # Clean rebase as today
      if [[ "$DRY_RUN" == true ]]; then
        echo -e "\033[33m🔍 Dry-run mode: Updates available from ${UPSTREAM} (${UPSTREAM_HASH:0:7}). Would rebase ${LOCAL_AHEAD_COUNT} commit(s). No changes applied.\033[0m"
        if [[ "$STASH_CREATED" == true && -n "$STASH_SHA" ]]; then
          git stash apply "$STASH_SHA" >/dev/null 2>&1 && drop_stash_by_sha "$STASH_SHA"
        fi
        release_lock
        remove_backup_refs
        trap - INT TERM HUP EXIT ERR
        exit 0
      fi

      ensure_backup_head
      echo -e "\033[34m🔄 Rebasing ${LOCAL_AHEAD_COUNT} local commit(s) onto ${UPSTREAM_HASH:0:7}...\033[0m"
      REBASE_OUTPUT=""
      if ! REBASE_OUTPUT="$(git rebase "$UPSTREAM_HASH" 2>&1)"; then
        CONFLICT_FILES="$(git diff --name-only --diff-filter=U 2>/dev/null || echo "")"
        if [[ -n "$CONFLICT_FILES" ]]; then
          echo -e "\n\033[1;31m💥 Commit rebase conflict detected in:\033[0m" >&2
          echo "$CONFLICT_FILES" | sed 's/^/   • /' >&2
          rollback "Rebase conflict encountered." 1
        elif echo "$REBASE_OUTPUT" | grep -qiE "gpg|signing|key"; then
          echo -e "\n\033[1;31m🔑 Commit signing failed on server.\033[0m" >&2
          echo -e "\033[33m💡 Hint: Ensure your SSH/GPG agent is unlocked and forwarded (e.g. ssh-add -l).\033[0m" >&2
          rollback "Commit signing failed during rebase." 1
        else
          [[ "$VERBOSE" == true ]] && echo "$REBASE_OUTPUT" >&2
          rollback "Rebase failed." 1
        fi
      fi
    fi
  fi

  # 7. Reapply stashed work onto updated branch
  if [[ "$STASH_CREATED" == true && -n "$STASH_SHA" ]]; then
    echo -e "\033[34m📦 Reapplying uncommitted local edits...\033[0m"
    APPLY_OUTPUT=""
    if APPLY_OUTPUT="$(git stash apply "$STASH_SHA" 2>&1)"; then
      drop_stash_by_sha "$STASH_SHA"
    else
      CONFLICT_FILES="$(git diff --name-only --diff-filter=U 2>/dev/null || echo "")"
      echo -e "\n\033[1;31m💥 Incoming upstream commits conflict with your uncommitted local edits:\033[0m" >&2
      if [[ -n "$CONFLICT_FILES" ]]; then
        echo "$CONFLICT_FILES" | sed 's/^/   • /' >&2
      elif [[ -n "$APPLY_OUTPUT" ]]; then
        echo "$APPLY_OUTPUT" | grep -E "overwritten|conflict" | sed 's/^/   • /' >&2 || true
      fi
      if [[ "$AUTO_RESOLVED" == true ]]; then
        git update-ref "refs/gsp/failed/${BACKUP_ID}" "$MERGE_COMMIT" 2>/dev/null || true
        echo -e "\033[33m📦 Auto-resolved merge commit saved at refs/gsp/failed/${BACKUP_ID}\033[0m" >&2
      fi
      # The half-applied worktree is fully reconstructible from STASH_SHA (still intact
      # in the stash list and the backup ref), so rollback may discard it.
      APPLY_FAILED=true
      rollback "Stash application collision with incoming changes." 1
    fi
  fi

  # 8. Sync secrets & verify
  SECRETS_TOOL="$(git rev-parse --show-toplevel 2>/dev/null)/bin/secrets"
  if [[ -x "$SECRETS_TOOL" ]]; then
    "$SECRETS_TOOL" pull --quiet >/dev/null 2>&1 || true
  fi

  if ! run_verify --changed-from "$PRE_HEAD"; then
    if [[ "$AUTO_RESOLVED" == true ]]; then
      git update-ref "refs/gsp/failed/${BACKUP_ID}" "$MERGE_COMMIT"
      echo -e "\033[33m📦 Failed auto-resolved merge commit saved at refs/gsp/failed/${BACKUP_ID}\033[0m" >&2
    fi
    # Re-park local edits so rollback can reset cleanly and restore them
    stash_worktree "safe-pull-verify-rollback-${EPOCH}-$$"
    rollback "script/test failed after the pull; restored ${PRE_HEAD:0:7}." 1
  fi

  # 9. Push unless --no-push / GSP_NO_PUSH=1
  if [[ "$NO_PUSH" == true ]]; then
    if [[ "$AUTO_RESOLVED" == true ]]; then
      echo -e "\033[1;33m⚠️  Warning: --no-push with auto-resolved merge; the next pull may stack on this unpushed merge.\033[0m" >&2
    fi
    break
  fi

  AHEAD_COUNT="$(git rev-list --count "${UPSTREAM}..HEAD" 2>/dev/null || echo 0)"
  if [[ "$AHEAD_COUNT" -gt 0 ]]; then
    echo -e "\033[34m🚀 Pushing updates to ${REMOTE_NAME}/${REMOTE_BRANCH}...\033[0m"
    PUSH_OUTPUT=""
    PUSH_STATUS=0
    if [[ "$VERBOSE" == true ]]; then
      run_with_watchdog 60 git push "$REMOTE_NAME" "HEAD:${REMOTE_BRANCH}" || PUSH_STATUS=$?
    else
      PUSH_OUTPUT="$(run_with_watchdog 60 git push "$REMOTE_NAME" "HEAD:${REMOTE_BRANCH}" 2>&1)" || PUSH_STATUS=$?
    fi

    if [[ "$PUSH_STATUS" -ne 0 ]]; then
      if [[ "$AUTO_RESOLVED" == true ]]; then
        # Park commit at refs/gsp/unpushed/<id>
        git update-ref "refs/gsp/unpushed/${BACKUP_ID}" "$MERGE_COMMIT"

        # Check if non-fast-forward rejection
        if echo "$PUSH_OUTPUT" | grep -qiE "non-fast-forward|fetch first|Updates were rejected"; then
          PUSH_ATTEMPTS=$((PUSH_ATTEMPTS + 1))
          if [[ "$PUSH_ATTEMPTS" -lt "$MAX_PUSH_ATTEMPTS" ]]; then
            echo -e "\033[33m⚠️  Remote moved (non-fast-forward rejection). Retrying (attempt $((PUSH_ATTEMPTS + 1))/${MAX_PUSH_ATTEMPTS})...\033[0m" >&2
            # Park local edits (they were re-applied in step 7), go back to
            # PRE_HEAD and redo the sync from step 3 against the new remote tip.
            # The original stash stays referenced by the backup ref throughout.
            stash_worktree "safe-pull-retry-stash-${BACKUP_ID}"
            git reset --hard "$PRE_HEAD" >/dev/null 2>&1 || true
            AUTO_RESOLVED=false
            continue
          fi
        fi

        # Any other failure or retries exhausted:
        echo "$PUSH_OUTPUT" >&2
        echo -e "\n\033[1;31m💥 Push to ${REMOTE_NAME}/${REMOTE_BRANCH} failed.\033[0m" >&2
        echo -e "\033[33m📦 Auto-resolved merge commit parked at refs/gsp/unpushed/${BACKUP_ID}\033[0m" >&2

        # Roll back to PRE_HEAD + stash
        stash_worktree "safe-pull-failed-push-${BACKUP_ID}"
        git reset --hard "$PRE_HEAD" >/dev/null 2>&1 || true
        if [[ "$STASH_CREATED" == true && -n "$STASH_SHA" ]]; then
          git stash apply "$STASH_SHA" >/dev/null 2>&1 && drop_stash_by_sha "$STASH_SHA" || true
        fi
        print_recovery
        release_lock
        exit 3
      else
        # Clean rebase push failure: keep state, warn, exit 3
        echo "$PUSH_OUTPUT" >&2
        echo -e "\n\033[1;33m⚠️  Push to ${REMOTE_NAME}/${REMOTE_BRANCH} failed. Local branch remains updated.\033[0m" >&2
        release_lock
        exit 3
      fi
    else
      if [[ "$VERBOSE" == true && -n "$PUSH_OUTPUT" ]]; then
        echo "$PUSH_OUTPUT"
      fi
      echo -e "\033[32m🚀 Pushed updates to ${REMOTE_NAME}/${REMOTE_BRANCH}.\033[0m"
    fi
  fi
  break
done

# 10. Clean exit
remove_backup_refs
release_lock
trap - INT TERM HUP EXIT ERR
echo -e "\033[1;32m🎉 Successfully synchronized ${CURRENT_BRANCH} with ${UPSTREAM} (${UPSTREAM_HASH:0:7}).\033[0m"
exit 0

